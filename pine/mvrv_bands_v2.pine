//@version=6
// MVRV Bands  v2   -- BTC and ETH presets
//
// realised price = realised cap / circulating supply
// MVRV          = price / realised price
// A band at multiplier m sits at realised price * m, i.e. the price where MVRV = m.
//
// Band levels are FULL-HISTORY MVRV PERCENTILES, computed in
// analysis/mvrv_bands.py from Coin Metrics daily data:
//   BTC  n = 5,957   2010-07-18 .. 2026-11-07
//   ETH  n = 4,110   2015-08-08 .. 2026-11-07
//
// v1 used levels derived from 5D red-streak exits. Those were dropped: the
// streaks depend on where the 5-day grid starts, and across the five possible
// alignments the ETH band floor ranged 0.406 to 0.871. Percentiles are
// grid-free and use thousands of observations instead of four to eight.
//
// Data symbols are INPUTS. TradingView's on-chain ticker strings are
// undocumented and vary by plan, so pick them with symbol search.

indicator("MVRV Bands v2", "MVRV Bands", overlay = true)

// ---------- preset ----------
grpP  = "Preset"
asset = input.string("ETH", "Asset", options = ["ETH", "BTC", "Custom"], group = grpP,
     tooltip = "Sets the band levels to that asset's own full-history MVRV percentiles.")
basis = input.string("Full history", "Percentile basis", options = ["Full history", "2019+"], group = grpP)

// p05 p10 p25 p50 p75 p90
f_lv() =>
    if asset == "BTC"
        basis == "Full history" ? [0.826, 0.920, 1.285, 1.711, 2.229, 2.982]
         : [0.900, 1.036, 1.328, 1.700, 2.122, 2.467]
    else if asset == "ETH"
        basis == "Full history" ? [0.624, 0.740, 0.967, 1.207, 1.549, 2.026]
         : [0.640, 0.739, 0.931, 1.130, 1.350, 1.657]
    else
        [0.60, 0.75, 0.95, 1.20, 1.55, 2.00]

[d05, d10, d25, d50, d75, d90] = f_lv()

grpC = "Custom levels (used when Asset = Custom)"
c05 = input.float(0.60, "5th pct",  step = 0.001, group = grpC)
c10 = input.float(0.75, "10th pct", step = 0.001, group = grpC)
c25 = input.float(0.95, "25th pct", step = 0.001, group = grpC)
c50 = input.float(1.20, "50th pct", step = 0.001, group = grpC)
c75 = input.float(1.55, "75th pct", step = 0.001, group = grpC)
c90 = input.float(2.00, "90th pct", step = 0.001, group = grpC)

m05 = asset == "Custom" ? c05 : d05
m10 = asset == "Custom" ? c10 : d10
m25 = asset == "Custom" ? c25 : d25
m50 = asset == "Custom" ? c50 : d50
m75 = asset == "Custom" ? c75 : d75
m90 = asset == "Custom" ? c90 : d90

// ---------- data ----------
grpD  = "Data"
rcSym = input.symbol("", "Realised cap symbol", group = grpD,
     tooltip = "Symbol-search 'realised market cap' for this asset. Blank = use manual realised price.")
spSym = input.symbol("", "Circulating supply symbol", group = grpD,
     tooltip = "Blank = derive supply from market cap / price.")
mcSym = input.symbol("", "Market cap symbol", group = grpD)
manRP = input.float(0.0, "Manual realised price", minval = 0, step = 0.01, group = grpD,
     tooltip = "Fallback only; it does not update. ETH 2208.78 and BTC 53951.14 on 2026-11-07.")

f_get(string s) => na(s) or s == "" ? na : request.security(s, "D", close, ignore_invalid_symbol = true)
rc = f_get(rcSym), sp = f_get(spSym), mc = f_get(mcSym)
supply   = not na(sp) ? sp : (not na(mc) and close > 0 ? mc / close : na)
realised = not na(rc) and not na(supply) and supply > 0 ? rc / supply : (manRP > 0 ? manRP : na)
mvrv     = not na(realised) and realised > 0 ? close / realised : na

// ---------- plot ----------
grpB = "Display"
show = input.bool(true, "Show bands", group = grpB)
fillZ = input.bool(true, "Shade cheap zone (below 25th pct)", group = grpB)

p05 = realised * m05, p10 = realised * m10, p25 = realised * m25
p50 = realised * m50, p75 = realised * m75, p90 = realised * m90

cCheap = #2f7a62, cMid = #8a8f98, cRich = #c2410c
l05 = plot(show ? p05 : na, "5th pct",  color.new(cCheap, 0),  1)
l25 = plot(show ? p25 : na, "25th pct", color.new(cCheap, 30), 1)
plot(show ? p10 : na, "10th pct", color.new(cCheap, 15), 1)
plot(show ? p50 : na, "Median",   color.new(cMid, 0),    2)
plot(show ? p75 : na, "75th pct", color.new(cRich, 35),  1)
plot(show ? p90 : na, "90th pct", color.new(cRich, 0),   1)
plot(show ? realised : na, "Realised price (MVRV 1.0)", color.new(cMid, 45), 1, plot.style_dashed)
fill(l05, l25, fillZ ? color.new(cCheap, 90) : na, "Cheap zone")

alertcondition(ta.crossunder(mvrv, m25), "MVRV below 25th percentile", "MVRV entered its historically cheap quartile")
alertcondition(ta.crossunder(mvrv, m10), "MVRV below 10th percentile", "MVRV in its cheapest decile")
alertcondition(ta.crossover(mvrv,  m75), "MVRV above 75th percentile", "MVRV entered its expensive quartile")

// ---------- readout ----------
grpT  = "Readout"
showT = input.bool(true, "Show table", group = grpT)
posIn = input.string("Top right", "Position", options = ["Top right","Top left","Bottom right","Bottom left"], group = grpT)
tp = posIn == "Top right" ? position.top_right : posIn == "Top left" ? position.top_left : posIn == "Bottom right" ? position.bottom_right : position.bottom_left

f_row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

var table tb = table.new(tp, 2, 8, border_width = 1)
if showT and barstate.islast
    src = not na(rc) ? "live feed" : manRP > 0 ? "manual (static)" : "NO DATA"
    cMv = na(mvrv) ? color.gray : mvrv < m25 ? cCheap : mvrv > m75 ? cRich : chart.fg_color
    pct = (p) => na(p) ? "n/a" : str.tostring(p, format.mintick) + "   " + str.tostring((p/close - 1)*100, "#.#") + "%"
    f_row(tb, 0, asset + " MVRV", na(mvrv) ? "n/a" : str.tostring(mvrv, "#.###"), cMv)
    f_row(tb, 1, "Realised price", na(realised) ? "n/a" : str.tostring(realised, format.mintick), chart.fg_color)
    f_row(tb, 2, "90th pct", pct(p90), color.new(cRich, 0))
    f_row(tb, 3, "75th pct", pct(p75), color.new(cRich, 35))
    f_row(tb, 4, "Median",   pct(p50), color.new(cMid, 0))
    f_row(tb, 5, "25th pct", pct(p25), color.new(cCheap, 30))
    f_row(tb, 6, "10th pct", pct(p10), color.new(cCheap, 15))
    f_row(tb, 7, "Source",   src, src == "NO DATA" ? color.red : color.gray)
