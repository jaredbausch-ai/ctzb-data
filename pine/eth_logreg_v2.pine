//@version=6
// ETH Logarithmic Regression Bands — recalibrated
// ---------------------------------------------------------------------------
// WHAT CHANGED vs the original
//  1. Coefficients refit by least squares on ETH 2016-2026:
//       ln(P) = 1.824 + 2.666*ln(years)   ->  baseCoeff 3.656, growthCoeff 2.666
//     The old 1.70 / 3.22 put the mean residual at +0.978, i.e. price averaged
//     2.66x ABOVE the Main Band. 80.6% of bars sat above the "Upper" band and
//     47.1% above "Super Bull". The bands described almost nothing.
//  2. Multipliers set from residual percentiles instead of round numbers, so
//     each band means something: 5 / 25 / 50 / 75 / 95th percentile of history.
//  3. Added a CHANNEL POSITION readout (0 = 5th pct band, 1 = 95th pct band).
//     That is the part with predictive value: bottom quintile ran 72% up over
//     60 days, top quintile 42%.
//  4. Optional WALK-FORWARD mode: refits the curve using only bars up to the
//     current one, so the historical bands are what you could actually have
//     seen at the time. Slower, but honest.
//  5. Projection fixed to plot a real forward curve rather than one straight
//     line, since the regression is curved in bar space.
// ---------------------------------------------------------------------------
indicator("ETH LogReg Bands (recalibrated)", "ETH LogReg v2", overlay=true, max_lines_count=500, max_labels_count=100)

// ---- inputs ----
gM = "Model"
basePrice   = input.float(0.16, "Launch price ($)", step=0.01, group=gM)
baseCoeff   = input.float(3.656, "Base coefficient", step=0.001, group=gM)
growthCoeff = input.float(2.666, "Growth coefficient", step=0.001, group=gM)
startYear   = input.int(2014, "Start year", minval=2009, maxval=2030, group=gM)
startMonth  = input.int(12, "Start month", minval=1, maxval=12, group=gM)
startDay    = input.int(3, "Start day", minval=1, maxval=31, group=gM)
walkFwd     = input.bool(false, "Walk-forward refit (honest bands)", group=gM)
minBars     = input.int(200, "Walk-forward: minimum bars before fitting", minval=50, group=gM)

gB = "Bands (residual percentiles)"
m05 = input.float(0.314, "5th pct  (deep value)", step=0.001, group=gB)
m25 = input.float(0.541, "25th pct (cheap)", step=0.001, group=gB)
m50 = input.float(0.914, "50th pct (fair)", step=0.001, group=gB)
m75 = input.float(1.585, "75th pct (rich)", step=0.001, group=gB)
m95 = input.float(3.970, "95th pct (euphoria)", step=0.001, group=gB)

gP = "Projection"
enableProj  = input.bool(false, "Forward projection", group=gP)
projDays    = input.int(180, "Days ahead", minval=1, group=gP)

gD = "Display"
showPos     = input.bool(true, "Show channel position table", group=gD)
showFill    = input.bool(true, "Shade the 25-75 zone", group=gD)

// ---- time base ----
startTs = timestamp(startYear, startMonth, startDay, 0, 0)
yrs = math.max(0.01, (time - startTs) / (1000.0 * 60 * 60 * 24 * 365.25))
lny = math.log(yrs)
lnp = math.log(close)

// ---- walk-forward OLS on (lny, lnp), expanding window ----
var float sX = 0.0
var float sY = 0.0
var float sXX = 0.0
var float sXY = 0.0
var int cnt = 0
sX += lny
sY += lnp
sXX += lny * lny
sXY += lny * lnp
cnt += 1
float wfB = growthCoeff
float wfA = math.log(basePrice) + baseCoeff
if walkFwd and cnt >= minBars
    float den = cnt*sXX - sX*sX
    if den != 0
        wfB := (cnt*sXY - sX*sY) / den
        wfA := (sY - wfB*sX) / cnt

a = walkFwd ? wfA : math.log(basePrice) + baseCoeff
b = walkFwd ? wfB : growthCoeff
reg = math.exp(a + b*lny)

B05 = reg*m05
B25 = reg*m25
B50 = reg*m50
B75 = reg*m75
B95 = reg*m95

// ---- plots ----
p05 = plot(B05, "5th pct - deep value", color=color.new(#1B7F5C,0), linewidth=2)
p25 = plot(B25, "25th pct - cheap",     color=color.new(#4CAF50,0), linewidth=1)
p50 = plot(B50, "50th pct - fair",      color=color.new(#2196F3,0), linewidth=2)
p75 = plot(B75, "75th pct - rich",      color=color.new(#FF9800,0), linewidth=1)
p95 = plot(B95, "95th pct - euphoria",  color=color.new(#E53935,0), linewidth=2)
fill(p25, p75, color=showFill ? color.new(#2196F3, 92) : na, title="fair value zone")

// ---- channel position: 0 at the 5th pct band, 1 at the 95th ----
pos = (math.log(close) - math.log(B05)) / (math.log(B95) - math.log(B05))

zoneOf(float p) =>
    string s = "EUPHORIA (>95th)"
    if p < 0.0
        s := "BELOW 5th - rare"
    else if p < 0.25
        s := "DEEP VALUE"
    else if p < 0.50
        s := "CHEAP"
    else if p < 0.75
        s := "FAIR"
    else if p <= 1.0
        s := "RICH"
    s

zoneCol(float p) =>
    color c = #E53935
    if p < 0.25
        c := #1B7F5C
    else if p < 0.50
        c := #4CAF50
    else if p < 0.75
        c := #2196F3
    else if p <= 1.0
        c := #FF9800
    c

// ---- forward projection: a real curve, not one straight line ----
if enableProj and barstate.islast
    int stepd = math.max(1, projDays / 20)
    float pyA = yrs
    float pB05 = B05
    float pB25 = B25
    float pB50 = B50
    float pB75 = B75
    float pB95 = B95
    for k = 1 to 20
        float pyB = yrs + (k*stepd) / 365.25
        float r2 = math.exp(a + b*math.log(pyB))
        int x1 = bar_index + math.round((k-1)*stepd)
        int x2 = bar_index + math.round(k*stepd)
        line.new(x1, pB05, x2, r2*m05, xloc.bar_index, color=color.new(#1B7F5C,30), style=line.style_dashed)
        line.new(x1, pB25, x2, r2*m25, xloc.bar_index, color=color.new(#4CAF50,50), style=line.style_dashed)
        line.new(x1, pB50, x2, r2*m50, xloc.bar_index, color=color.new(#2196F3,30), style=line.style_dashed)
        line.new(x1, pB75, x2, r2*m75, xloc.bar_index, color=color.new(#FF9800,50), style=line.style_dashed)
        line.new(x1, pB95, x2, r2*m95, xloc.bar_index, color=color.new(#E53935,30), style=line.style_dashed)
        pB05 := r2*m05
        pB25 := r2*m25
        pB50 := r2*m50
        pB75 := r2*m75
        pB95 := r2*m95

// ---- readout ----
var table t = table.new(position.top_right, 2, 8, border_width=1, frame_width=1, frame_color=color.new(color.gray,50))
cell(int r, int c, string s, color tx, color bg) =>
    table.cell(t, c, r, s, text_color=tx, bgcolor=bg, text_size=size.small)

if showPos and barstate.islast
    color bgd = color.new(color.black, 55)
    cell(0, 0, zoneOf(pos), color.white, color.new(zoneCol(pos), 10))
    cell(0, 1, "pos " + str.tostring(pos, "#.##"), color.white, color.new(zoneCol(pos), 10))
    cell(1, 0, "price", color.silver, bgd)
    cell(1, 1, str.tostring(close, "#.##"), color.white, bgd)
    cell(2, 0, "95th euphoria", color.new(#E53935,20), bgd)
    cell(2, 1, str.tostring(B95, "#") + "  " + str.tostring((B95/close-1)*100, "+#") + "%", color.silver, bgd)
    cell(3, 0, "75th rich", color.new(#FF9800,20), bgd)
    cell(3, 1, str.tostring(B75, "#") + "  " + str.tostring((B75/close-1)*100, "+#") + "%", color.silver, bgd)
    cell(4, 0, "50th fair", color.new(#2196F3,20), bgd)
    cell(4, 1, str.tostring(B50, "#") + "  " + str.tostring((B50/close-1)*100, "+#") + "%", color.silver, bgd)
    cell(5, 0, "25th cheap", color.new(#4CAF50,20), bgd)
    cell(5, 1, str.tostring(B25, "#") + "  " + str.tostring((B25/close-1)*100, "+#") + "%", color.silver, bgd)
    cell(6, 0, "5th deep value", color.new(#1B7F5C,20), bgd)
    cell(6, 1, str.tostring(B05, "#") + "  " + str.tostring((B05/close-1)*100, "+#") + "%", color.silver, bgd)
    cell(7, 0, walkFwd ? "walk-fwd fit" : "fixed fit", color.new(color.silver,40), bgd)
    cell(7, 1, "b=" + str.tostring(b, "#.###"), color.new(color.silver,40), bgd)

// ---- alerts ----
alertcondition(ta.crossunder(pos, 0.25), "Entered DEEP VALUE", "ETH below the 25th percentile band")
alertcondition(ta.crossover(pos, 1.0),   "Entered EUPHORIA",   "ETH above the 95th percentile band")
alertcondition(ta.crossover(pos, 0.50),  "Crossed above FAIR", "ETH above the 50th percentile band")
alertcondition(ta.crossunder(pos, 0.50), "Crossed below FAIR", "ETH below the 50th percentile band")
