//@version=6
// =============================================================================
//  CT RSI ZONE BOUNCE - ETH 2D | ENTRIES ONLY | v2 + TROUGH DISAGREEMENT
// -----------------------------------------------------------------------------
//  Flags confirmed CT RSI swing lows, classifies them into four zone buckets,
//  and grades each one by whether the STOCH trough moved OPPOSITE to the CT
//  trough versus the previous signal (the "disagreement" filter).
//
//  Disagreement backtest, COINBASE:ETHUSD 2D, BTC bull windows only:
//     DISAGREE  n=33   hit 60d 88%   median upside 60d 53.3%   avg 93.4%
//     ALIGNED   n=104  hit 60d 62%   median upside 60d 33.8%   avg 61.9%
//  Held in all three cycles: 88/61, 82/72, 93/52.
//
//  MATCHED SETTINGS: RSI 14 | Stoch RSI 14, 14, 3, 3
//  No exit logic. Past results, not a forecast.
// =============================================================================

indicator("CT RSI Zone Bounce - ETH 2D v2", shorttitle="CT Zone Bounce v2", overlay=false, max_labels_count=500, max_lines_count=500)

// ---------------------------------------------------------------- INPUTS ----
grpI = "Indicator settings"
rsiLen   = input.int(14, "CT RSI length", group=grpI, minval=2)
rsiSrc   = input.source(close, "CT RSI source", group=grpI)
sigLen   = input.int(14, "CT RSI signal line", group=grpI, minval=1)
stochLen = input.int(14, "Stoch RSI length", group=grpI, minval=2)
smoothK  = input.int(3, "Stoch %K smoothing", group=grpI, minval=1)
smoothD  = input.int(3, "Stoch %D smoothing", group=grpI, minval=1)

grpZ = "Zone brackets"
zBear  = input.float(40, "Bearish control ceiling", group=grpZ)
zMid   = input.float(50, "Neutral line", group=grpZ)
zBull  = input.float(60, "Bullish control floor", group=grpZ)
bSplit = input.float(55, "A/B vs C split", group=grpZ)
dSplit = input.float(65, "C vs D split", group=grpZ)

grpP = "Pivot detection"
pvLeft  = input.int(3, "Pivot left bars", group=grpP, minval=1)
pvRight = input.int(3, "Pivot right bars", group=grpP, minval=1, tooltip="Signal fires this many bars AFTER the RSI low. 3 on 2D = 6 days.")

grpC = "Cycle filter (BTC ATH anchored)"
useCycle = input.bool(true, "Only signal inside BTC 3-year bull windows", group=grpC)
b1s = input.time(timestamp("2014-12-04T00:00"), "Bull 1 start", group=grpC)
b1e = input.time(timestamp("2017-12-17T00:00"), "Bull 1 end (BTC ATH)", group=grpC)
b2s = input.time(timestamp("2018-12-17T00:00"), "Bull 2 start", group=grpC)
b2e = input.time(timestamp("2021-11-10T00:00"), "Bull 2 end (BTC ATH)", group=grpC)
b3s = input.time(timestamp("2022-11-10T00:00"), "Bull 3 start", group=grpC)
b3e = input.time(timestamp("2025-10-06T00:00"), "Bull 3 end (BTC ATH)", group=grpC)
b4s = input.time(timestamp("2026-10-06T00:00"), "Bull 4 start (current)", group=grpC)
b4e = input.time(timestamp("2029-10-06T00:00"), "Bull 4 assumed end", group=grpC)

grpG = "Disagreement filter"
useDis      = input.bool(true, "Grade troughs by CT vs Stoch disagreement", group=grpG)
disOnly     = input.bool(false, "Show ONLY disagreement signals", group=grpG)
showConnect = input.bool(true, "Draw comparison line to previous trough", group=grpG)
minGapBars  = input.int(0, "Ignore prior trough if older than N bars (0=off)", group=grpG, minval=0)

grpD = "Display"
horizon   = input.string("60d", "Stats horizon on labels", options=["20d","40d","60d","90d","120d"], group=grpD)
statMode  = input.string("Disagreement split", "Label stats source", options=["Disagreement split","Bucket"], group=grpD)
showTbl   = input.bool(true, "Show stats table", group=grpD)
showStoch = input.bool(true, "Plot Stoch RSI", group=grpD)
showOff   = input.bool(false, "Show signals outside bull windows (greyed)", group=grpD)
lblSize   = input.string("small", "Label size", options=["tiny","small","normal"], group=grpD)

// ------------------------------------------------------------ CALCULATION ---
ctRsi  = ta.rsi(rsiSrc, rsiLen)
ctSig  = ta.ema(ctRsi, sigLen)
stochV = ta.stoch(ctRsi, ctRsi, ctRsi, stochLen)
kLine  = ta.sma(stochV, smoothK)
dLine  = ta.sma(kLine, smoothD)

inWin(int s, int e) =>
    time >= s and time <= e

inBull = inWin(b1s, b1e) or inWin(b2s, b2e) or inWin(b3s, b3e) or inWin(b4s, b4e)
regimeOK = not useCycle or inBull

// ------------------------------------------------------------ ZONE BANDS ----
p100 = hline(100, "", color=color.new(color.gray, 80))
pBul = hline(60, "Bullish control floor", color=color.new(color.teal, 40))
pMid = hline(50, "Neutral line", color=color.new(color.gray, 30), linestyle=hline.style_dashed)
pBer = hline(40, "Bearish control ceiling", color=color.new(color.red, 40))
p0   = hline(0, "", color=color.new(color.gray, 80))
fill(pBul, p100, color=color.new(color.teal, 92), title="Bullish control zone")
fill(pMid, pBul, color=color.new(color.teal, 96), title="Neutral bullish")
fill(pBer, pMid, color=color.new(color.red, 96), title="Neutral bearish")
fill(p0, pBer, color=color.new(color.red, 92), title="Bearish control zone")

plot(ctRsi, "CT RSI", color=color.new(#7E57C2, 0), linewidth=2)
plot(ctSig, "Signal", color=color.new(color.orange, 30))
plot(showStoch ? kLine : na, "Stoch %K", color=color.new(color.blue, 45))
plot(showStoch ? dLine : na, "Stoch %D", color=color.new(color.red, 55))

// -------------------------------------------------------- PIVOT DETECTION ---
pv = ta.pivotlow(ctRsi, pvLeft, pvRight)
isPivot = not na(pv)
troughK = kLine[pvRight]
pvBar = bar_index - pvRight

bucket = isPivot ? (pv < zBear ? "A" : pv < bSplit ? "B" : pv < dSplit ? "C" : "D") : "-"

// ------------------------------------------- TROUGH-TO-TROUGH DISAGREEMENT ---
var float prevCt = na
var float prevK = na
var int prevBar = na

signalBar = isPivot and regimeOK
hasAny = signalBar and not na(prevCt)
ageOK = hasAny and (minGapBars == 0 or (pvBar - prevBar) <= minGapBars)
hasPrev = hasAny and ageOK

dCt = hasPrev ? pv - prevCt : na
dK  = hasPrev ? troughK - prevK : na
disagree = hasPrev and ((dCt > 0 and dK < 0) or (dCt < 0 and dK > 0))

// -------------------------------------------------------- HISTORICAL STATS ---
pickH(string h, float v20, float v40, float v60, float v90, float v120) =>
    float r = v120
    if h == "20d"
        r := v20
    else if h == "40d"
        r := v40
    else if h == "60d"
        r := v60
    else if h == "90d"
        r := v90
    r

hitDis(string h) =>
    pickH(h, 61.0, 73.0, 88.0, 82.0, 76.0)

hitAli(string h) =>
    pickH(h, 55.0, 62.0, 62.0, 67.0, 63.0)

upMedDis(string h) =>
    pickH(h, 14.2, 36.3, 53.3, 73.4, 78.8)

upMedAli(string h) =>
    pickH(h, 13.4, 22.3, 33.8, 48.8, 63.0)

upAvgDis(string h) =>
    pickH(h, 28.7, 57.0, 93.4, 186.4, 323.7)

upAvgAli(string h) =>
    pickH(h, 22.1, 41.6, 61.9, 90.6, 139.3)

hitBk(string b, string h) =>
    float r = 0.0
    if b == "A"
        r := pickH(h, 40.0, 57.0, 71.0, 74.0, 74.0)
    else if b == "B"
        r := pickH(h, 63.0, 65.0, 69.0, 68.0, 60.0)
    else if b == "C"
        r := pickH(h, 52.0, 68.0, 64.0, 68.0, 68.0)
    else
        r := pickH(h, 77.0, 77.0, 69.0, 85.0, 77.0)
    r

upMedBk(string b, string h) =>
    float r = 0.0
    if b == "A"
        r := pickH(h, 9.9, 17.2, 33.2, 49.3, 70.1)
    else if b == "B"
        r := pickH(h, 13.5, 29.3, 37.5, 50.4, 62.3)
    else if b == "C"
        r := pickH(h, 19.4, 23.6, 37.9, 53.5, 72.5)
    else
        r := pickH(h, 40.2, 62.2, 62.2, 107.2, 228.9)
    r

upAvgBk(string b, string h) =>
    float r = 0.0
    if b == "A"
        r := pickH(h, 15.9, 26.5, 38.8, 69.9, 105.7)
    else if b == "B"
        r := pickH(h, 19.2, 34.2, 56.3, 85.2, 124.0)
    else if b == "C"
        r := pickH(h, 26.5, 61.7, 88.1, 124.7, 292.8)
    else
        r := pickH(h, 63.6, 120.3, 180.7, 347.3, 471.7)
    r

sampleN(string b) =>
    int r = 13
    if b == "A"
        r := 35
    else if b == "B"
        r := 65
    else if b == "C"
        r := 25
    r

bucketName(string b) =>
    string r = "BULL CONTROL dip"
    if b == "A"
        r := "BEARISH CONTROL bounce"
    else if b == "B"
        r := "NEUTRAL LINE bounce"
    else if b == "C"
        r := "BULL-ZONE BASE bounce"
    r

bucketCol(string b) =>
    color r = #FFA726
    if b == "A"
        r := #26A69A
    else if b == "B"
        r := #42A5F5
    else if b == "C"
        r := #AB47BC
    r

aQuality = isPivot and bucket == "A" and troughK >= 20 and troughK < 50

// ------------------------------------------------------------- SIGNAL PLOT --
passFilter = not disOnly or disagree
drawIt = isPivot and (regimeOK or showOff) and passFilter
lsz = lblSize == "tiny" ? size.tiny : lblSize == "normal" ? size.normal : size.small

useDisStats = useDis and statMode == "Disagreement split" and hasPrev
hitShow   = useDisStats ? (disagree ? hitDis(horizon) : hitAli(horizon)) : hitBk(bucket, horizon)
upMedShow = useDisStats ? (disagree ? upMedDis(horizon) : upMedAli(horizon)) : upMedBk(bucket, horizon)
upAvgShow = useDisStats ? (disagree ? upAvgDis(horizon) : upAvgAli(horizon)) : upAvgBk(bucket, horizon)
nShow     = useDisStats ? (disagree ? 33 : 104) : sampleN(bucket)

if drawIt
    bool live = regimeOK
    string hdr = bucket
    if useDis and disagree
        hdr := "** DISAGREE  -  " + bucket
    else if useDis and hasPrev
        hdr := "aligned  -  " + bucket
    string varTxt = ""
    if useDis and disagree
        varTxt := dCt > 0 ? "CT higher low + stoch deeper\n" : "CT lower low + stoch higher\n"
    string prevTxt = "no prior trough to compare\n"
    if hasPrev
        prevTxt := "prev: CT " + str.tostring(prevCt, "#.#") + " -> " + str.tostring(pv, "#.#") + "  |  K " + str.tostring(prevK, "#.#") + " -> " + str.tostring(troughK, "#.#") + "\n"
    string l1 = hdr + " - " + bucketName(bucket) + "\n"
    string l2 = "Hit rate " + horizon + ": " + str.tostring(hitShow, "#") + "%  (n=" + str.tostring(nShow) + ")\n"
    string l3 = "Upside " + horizon + ": med " + str.tostring(upMedShow, "#.#") + "%  -  avg " + str.tostring(upAvgShow, "#.#") + "%"
    string l4 = aQuality ? "\n* stoch 20-50 at trough" : ""
    string l5 = live ? "" : "\n[outside bull window]"
    string txt = l1 + varTxt + prevTxt + l2 + l3 + l4 + l5
    color bg = color.new(bucketCol(bucket), 25)
    if not live
        bg := color.new(color.gray, 55)
    else if useDis and disagree
        bg := color.new(#FFD54F, 5)
    color tc = (live and useDis and disagree) ? color.black : color.white
    label.new(pvBar, pv, text=txt, style=label.style_label_up, color=bg, textcolor=tc, size=lsz, yloc=yloc.price)
    if showConnect and hasPrev and useDis
        color lc = disagree ? color.new(#FFD54F, 20) : color.new(color.gray, 70)
        int lw = disagree ? 2 : 1
        line.new(prevBar, prevCt, pvBar, pv, xloc=xloc.bar_index, color=lc, width=lw, style=line.style_dotted)

plotshape(useDis and disagree and regimeOK and passFilter, "Disagreement", shape.diamond, location.bottom, color=color.new(#FFD54F, 0), size=size.tiny)
plotshape(isPivot and regimeOK and passFilter ? pv : na, "Signal", shape.triangleup, location.absolute, color=color.new(#26A69A, 0), size=size.tiny, offset=-pvRight)
bgcolor(useCycle and inBull ? color.new(color.teal, 95) : na, title="Bull window shading")

// update the reference trough AFTER everything above has used the old one
if signalBar
    prevCt := pv
    prevK := troughK
    prevBar := pvBar

// ----------------------------------------------------------------- ALERTS ---
alertcondition(isPivot and regimeOK, "Any zone bounce", "CT RSI zone bounce confirmed on ETH 2D")
alertcondition(isPivot and regimeOK and disagree, "Disagreement bounce", "CT/Stoch trough DISAGREEMENT - 88pct hit rate at 60d historically")
alertcondition(isPivot and regimeOK and disagree and dCt > 0, "Disagree: CT higher low", "CT higher low + stoch deeper low (93pct hit 60d, n=15)")
alertcondition(isPivot and regimeOK and disagree and dCt < 0, "Disagree: CT lower low", "CT lower low + stoch higher low (83pct hit 60d, n=18)")
alertcondition(isPivot and regimeOK and bucket == "A", "A - bearish control bounce", "CT RSI bounced off the bearish control zone")
alertcondition(isPivot and regimeOK and bucket == "B", "B - neutral line bounce", "CT RSI bounced off the neutral line")
alertcondition(isPivot and regimeOK and bucket == "C", "C - bull-zone base bounce", "CT RSI bounced off the base of the bullish control zone")
alertcondition(isPivot and regimeOK and bucket == "D", "D - bull control dip", "CT RSI dipped inside the bullish control zone")

// ------------------------------------------------------------ STATS TABLE ---
var table st = table.new(position.top_right, 6, 12, border_width=1, frame_width=1, frame_color=color.gray)

cH(int c, int r, string s) =>
    table.cell(st, c, r, s, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.tiny)

cB(int c, int r, string s, color bg) =>
    table.cell(st, c, r, s, text_color=color.white, bgcolor=bg, text_size=size.tiny)

cN(int c, int r, string s) =>
    table.cell(st, c, r, s, text_color=color.white, bgcolor=color.new(color.black, 55), text_size=size.tiny)

cG(int c, int r, string s) =>
    table.cell(st, c, r, s, text_color=color.silver, bgcolor=color.new(color.black, 70), text_size=size.tiny)

if showTbl and barstate.islast
    cB(0, 0, "DISAGREEMENT SPLIT", color.new(#FFD54F, 30))
    table.merge_cells(st, 0, 0, 5, 0)
    cH(0, 1, "")
    cH(1, 1, "n")
    cH(2, 1, "Hit 40d")
    cH(3, 1, "Hit 60d")
    cH(4, 1, "Up med 60d")
    cH(5, 1, "Up avg 60d")
    cB(0, 2, "** Disagree", color.new(#FFD54F, 25))
    cN(1, 2, "33")
    cN(2, 2, "73%")
    cN(3, 2, "88%")
    cN(4, 2, "53.3%")
    cN(5, 2, "93.4%")
    cB(0, 3, "Aligned", color.new(color.gray, 35))
    cN(1, 3, "104")
    cN(2, 3, "62%")
    cN(3, 3, "62%")
    cN(4, 3, "33.8%")
    cN(5, 3, "61.9%")
    cG(0, 4, "By cycle, hit 60d - disagree / aligned:   2016-17  88/61   |   2018-21  82/72   |   2022-25  93/52")
    table.merge_cells(st, 0, 4, 5, 4)
    cB(0, 5, "BUCKET SPLIT", color.new(color.gray, 30))
    table.merge_cells(st, 0, 5, 5, 5)
    cH(0, 6, "Bucket")
    cH(1, 6, "n")
    cH(2, 6, "Hit 40d")
    cH(3, 6, "Hit 60d")
    cH(4, 6, "Up med 60d")
    cH(5, 6, "Up avg 60d")
    cB(0, 7, "A <40", color.new(#26A69A, 25))
    cN(1, 7, "35")
    cN(2, 7, "57%")
    cN(3, 7, "71%")
    cN(4, 7, "33.2%")
    cN(5, 7, "38.8%")
    cB(0, 8, "B 40-55", color.new(#42A5F5, 25))
    cN(1, 8, "65")
    cN(2, 8, "65%")
    cN(3, 8, "69%")
    cN(4, 8, "37.5%")
    cN(5, 8, "56.3%")
    cB(0, 9, "C 55-65", color.new(#AB47BC, 25))
    cN(1, 9, "25")
    cN(2, 9, "68%")
    cN(3, 9, "64%")
    cN(4, 9, "37.9%")
    cN(5, 9, "88.1%")
    cB(0, 10, "D >65", color.new(#FFA726, 25))
    cN(1, 10, "13")
    cN(2, 10, "77%")
    cN(3, 10, "69%")
    cN(4, 10, "62.2%")
    cN(5, 10, "180.7%")
    cG(0, 11, "ETHUSD 2D - bull windows only - 2016-2026 - RSI14 / StochRSI 14,14,3,3 - past results, not a forecast")
    table.merge_cells(st, 0, 11, 5, 11)
