//@version=6
// CTZB SCANNER v10  -  generated by pine/build_v10.py (edit the .in templates, not this file)
// ---------------------------------------------------------------------------
// v10 RUNS ON THE SAME ENGINE AS CT ZONE BOUNCE v16, so a row here and the card on
// that chart always agree. One row per chart, all ten the console reads: ETH and BTC
// 1D, 2D, 3D, 5D and 8D (v9 watched six and missed BTC 3D/5D/8D and ETH 8D).
//
//  GRADE   the console's grade for a forming low. BTC is exact. ETH carries an
//          asterisk (B*): graded without funding, which TradingView cannot read.
//  ODDS    the card headline: rose 10% and never fell 25%, within 60 days of buying,
//          from like-for-like past trades (docs/CARD_SPEC.md). PAST is how many.
//  HOLD    the close the confirmation bar must hold for the low to confirm.
//  LAST    days since the last confirmed signal on that chart.
// Replaced from v9: the hard-coded ODDS table (measured on the hand-drawn bull windows,
// unchanged since v6), the three-dot GRADE, STEP and CONF columns. The TAG column is
// kept, but the bucket letter is where the CT low sat, not a grade.
// Alerts: create one alert with "Any alert() function call". It fires when a low starts
// forming and when one confirms, with the copy line to paste to Claude.
// Card numbers are frozen at the build date in the footer; the console keeps updating.
// Entry quality only: computed signals, never fills; no exit in the data.
// ---------------------------------------------------------------------------
indicator("CTZB Scanner v10", "CTZB-SCAN", overlay=false)

//@@DATA@@
//@@ENGINE@@

gS = "Scanner"
sPos  = input.string("Top right", "Position", options=["Top right", "Bottom right", "Top left", "Bottom left"], group=gS)
sSize = input.string("Small", "Text size", options=["Tiny", "Small", "Normal", "Large"], group=gS)
aForm = input.bool(true, "Alert when a low starts forming", group=gS)
aConf = input.bool(true, "Alert when a low confirms", group=gS)

var table TB = table.new(sPos == "Bottom right" ? position.bottom_right : sPos == "Top left" ? position.top_left : sPos == "Bottom left" ? position.bottom_left : position.top_right, 8, 14, border_width=1, frame_width=1, frame_color=color.new(color.gray, 55), bgcolor=color.new(#0D1114, 0))
tsz() =>
    sSize == "Tiny" ? size.tiny : sSize == "Normal" ? size.normal : sSize == "Large" ? size.large : size.small
put(int c, int r, string s, color tx, color bg) =>
    table.cell(TB, c, r, s, text_color=tx, bgcolor=bg, text_size=tsz(), text_halign=c == 0 ? text.align_left : text.align_center)

// what each chart looked like on the previous update, for the alerts
var array<int> prevFb = array.new_int(10, -1)
var array<int> prevD0 = array.new_int(10, na)
var array<string> prevLine = array.new_string(10, "")

if barstate.islast
    table.clear(TB, 0, 0, 7, 13)
    color H = color.new(#1E293B, 0)
    color P = color.new(#151B1F, 0)
    color DIM = color.new(#93A1AA, 0)
    color OK = color.new(#53C18B, 0)
    color WN = color.new(#D9A64A, 0)
    put(0, 0, "CHART", color.white, H)
    put(1, 0, "LOW", color.white, H)
    put(2, 0, "TAG", color.white, H)
    put(3, 0, "GRADE", color.white, H)
    put(4, 0, "ODDS", color.white, H)
    put(5, 0, "PAST", color.white, H)
    put(6, 0, "HOLD ABOVE", color.white, H)
    put(7, 0, "LAST", color.white, H)
    for i = 0 to CARDS.size() - 1
        Card c = CARDS.get(i)
        int r = i + 1
        bool f = c.fb > 0
        color bg = f ? color.new(gradeColor(c.grade), 25) : P
        color tx = f ? color.white : DIM
        put(0, r, c.ch, color.white, bg)
        put(1, r, f ? "forming · confirms " + fDay(c.d0) : "-", tx, bg)
        put(2, r, f ? c.tag : "-", tx, bg)
        put(3, r, f ? c.grade : "-", color.white, bg)
        put(4, r, f ? fPct(c.s.get(S_SURV10)) : "-", f ? OK : DIM, bg)
        put(5, r, f ? str.tostring(c.s.get(S_N), "#") : "-", tx, bg)
        put(6, r, f ? (na(c.kill) ? str.tostring(c.need) + " bars to close" : fPx(c.kill)) : "-", tx, bg)
        put(7, r, na(c.lastD0) ? "-" : str.tostring(math.floor((timenow - c.lastD0) / DAY_MS) - 1) + "d", DIM, bg)
        // alerts: a new forming low, or a confirmation (the last signal's date moved)
        if barstate.isrealtime
            if aForm and f and prevFb.get(i) == 0
                alert("CTZB: " + c.ch + " low forming, confirms " + fDate(c.d0) + " · " + c.grade + " · " + fPct(c.s.get(S_SURV10)) + " of " + str.tostring(c.s.get(S_N), "#") + " rose 10% and never fell 25% within 60 days. " + copyLine(c), alert.freq_once_per_bar)
            if aConf and not na(c.lastD0) and not na(prevD0.get(i)) and c.lastD0 > prevD0.get(i)
                alert("CTZB: " + c.ch + " CONFIRMED. " + prevLine.get(i), alert.freq_once_per_bar)
        prevFb.set(i, c.fb)
        prevD0.set(i, c.lastD0)
        if f
            prevLine.set(i, copyLine(c))
    put(0, 11, "Regime " + (liveBull ? "BULL" : "BEAR") + (regimeMoved ? " · CHANGED since build: rebuild" : ""), liveBull ? OK : color.new(#E2766A, 0), H)
    table.merge_cells(TB, 0, 11, 7, 11)
    put(0, 12, "ODDS: rose 10% and never fell 25% within 60 days, like-for-like past trades. *ETH graded without funding (TradingView can't read it); the console's ETH grade is official.", WN, P)
    table.merge_cells(TB, 0, 12, 7, 12)
    put(0, 13, "Card numbers as of " + BUILT + ". Past signals, not real trades. Entry quality only.", DIM, P)
    table.merge_cells(TB, 0, 13, 7, 13)

// No bars: the pane is just the readout. Pine needs one output call, so this draws nothing.
plot(na, "", display=display.none)
