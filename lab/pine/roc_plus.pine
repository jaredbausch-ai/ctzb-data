//@version=6
// ROC+ — Rate of Change, improved. Statistics lab (stats-lab branch), 25 Nov 2026.
// Not tested as a CTZB lens. A chart tool only until a declared test says otherwise.
indicator(title="Rate of Change+", shorttitle="ROC+", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

// ───────────────────────── Inputs
G_CALC = "Calculation"
length     = input.int(9, "Length", minval=1, group=G_CALC)
source     = input.source(close, "Source", group=G_CALC)
mode       = input.string("Percent", "Mode", options=["Percent", "Log %", "Volatility-normalized"], group=G_CALC,
             tooltip="Percent: the classic ROC.\nLog %: symmetric, so +X and -X are the same size of move.\nVolatility-normalized: the move divided by what a normal move of that length has been lately (in sigma), so readings compare across quiet and violent markets.")
volLen     = input.int(100, "Normalization lookback", minval=10, group=G_CALC, tooltip="Bars of 1-bar log returns used to size a normal move. Volatility-normalized mode only.")
smoothType = input.string("None", "Smoothing", options=["None", "EMA", "SMA", "WMA", "HMA"], group=G_CALC)
smoothLen  = input.int(3, "Smoothing length", minval=2, group=G_CALC)

G_SIG = "Signal line"
showSig  = input.bool(true, "Show signal line", group=G_SIG)
sigLen   = input.int(9, "Signal length", minval=1, group=G_SIG)
showHist = input.bool(true, "Show histogram (ROC minus signal)", group=G_SIG)

G_BAND = "Extremes"
bandType = input.string("Percentile", "Bands", options=["Percentile", "Fixed", "None"], group=G_BAND,
           tooltip="Percentile: the ROC's own recent extremes, so the bands adapt as the market's range changes.\nFixed: your own levels, in the units of the Mode (% or sigma).")
pctLen   = input.int(250, "Percentile lookback", minval=20, group=G_BAND)
pctHi    = input.float(90, "Upper percentile", minval=50, maxval=100, group=G_BAND)
pctLo    = input.float(10, "Lower percentile", minval=0, maxval=50, group=G_BAND)
fixHi    = input.float(10, "Fixed upper", group=G_BAND)
fixLo    = input.float(-10, "Fixed lower", group=G_BAND)

G_DIV = "Divergence"
showDiv  = input.bool(true, "Show regular divergences", group=G_DIV)
pivL     = input.int(5, "Pivot bars left", minval=1, group=G_DIV)
pivR     = input.int(5, "Pivot bars right", minval=1, group=G_DIV, tooltip="A pivot is only known this many bars after it prints, so the label appears late by this many bars.")
rangeMin = input.int(5, "Min bars between pivots", minval=1, group=G_DIV)
rangeMax = input.int(60, "Max bars between pivots", minval=2, group=G_DIV)

// ───────────────────────── Core
pctRoc = 100 * (source - source[length]) / source[length]
logMove = math.log(source / source[length])
logRoc = 100 * logMove
r1 = math.log(source / source[1])
normalMove = ta.stdev(r1, volLen) * math.sqrt(length)
zRoc = normalMove > 0 ? logMove / normalMove : na

raw = mode == "Percent" ? pctRoc : mode == "Log %" ? logRoc : zRoc

// Every smoother is computed on every bar, then one is picked (keeps the ta.* history consistent)
sEma = ta.ema(raw, smoothLen)
sSma = ta.sma(raw, smoothLen)
sWma = ta.wma(raw, smoothLen)
sHma = ta.hma(raw, smoothLen)
roc = switch smoothType
    "EMA" => sEma
    "SMA" => sSma
    "WMA" => sWma
    "HMA" => sHma
    => raw

sig  = ta.ema(roc, sigLen)
hist = roc - sig

// ───────────────────────── Bands
upPct = ta.percentile_nearest_rank(roc, pctLen, pctHi)
loPct = ta.percentile_nearest_rank(roc, pctLen, pctLo)
upper = bandType == "Percentile" ? upPct : bandType == "Fixed" ? fixHi : na
lower = bandType == "Percentile" ? loPct : bandType == "Fixed" ? fixLo : na

// ───────────────────────── Divergence (regular only)
plFound = not na(ta.pivotlow(roc, pivL, pivR))
phFound = not na(ta.pivothigh(roc, pivL, pivR))
barsSincePL = ta.barssince(plFound[1])
barsSincePH = ta.barssince(phFound[1])
plInRange = barsSincePL >= rangeMin and barsSincePL <= rangeMax
phInRange = barsSincePH >= rangeMin and barsSincePH <= rangeMax
prevPLosc  = ta.valuewhen(plFound, roc[pivR], 1)
prevPLlow  = ta.valuewhen(plFound, low[pivR], 1)
prevPHosc  = ta.valuewhen(phFound, roc[pivR], 1)
prevPHhigh = ta.valuewhen(phFound, high[pivR], 1)

bullCond = showDiv and plFound and plInRange and low[pivR] < prevPLlow and roc[pivR] > prevPLosc
bearCond = showDiv and phFound and phInRange and high[pivR] > prevPHhigh and roc[pivR] < prevPHosc

// ───────────────────────── Colours
C_UP   = #26A69A
C_DN   = #EF5350
C_SIG  = #FF9800
C_BAND = #787B86

rising  = roc > roc[1]
lineCol = roc >= 0 ? (rising ? C_UP : color.new(C_UP, 45)) : (rising ? color.new(C_DN, 45) : C_DN)
histCol = hist >= 0 ? (hist > hist[1] ? color.new(C_UP, 40) : color.new(C_UP, 75)) : (hist < hist[1] ? color.new(C_DN, 40) : color.new(C_DN, 75))

// ───────────────────────── Plots
plot(showHist ? hist : na, "Histogram", histCol, style=plot.style_columns)
hline(0, "Zero line", C_BAND)
pUp  = plot(upper, "Upper band", color.new(C_BAND, 40), style=plot.style_linebr)
pLo  = plot(lower, "Lower band", color.new(C_BAND, 40), style=plot.style_linebr)
pRoc = plot(roc, "ROC", lineCol, 2)
plot(showSig ? sig : na, "Signal", C_SIG, 1)

fill(pRoc, pUp, color = not na(upper) and roc > upper ? color.new(C_UP, 75) : na, title="Above upper band")
fill(pRoc, pLo, color = not na(lower) and roc < lower ? color.new(C_DN, 75) : na, title="Below lower band")

plot(plFound ? roc[pivR] : na, "Bullish divergence line", bullCond ? C_UP : na, 2, offset=-pivR, display=display.pane)
plot(phFound ? roc[pivR] : na, "Bearish divergence line", bearCond ? C_DN : na, 2, offset=-pivR, display=display.pane)
plotshape(bullCond ? roc[pivR] : na, "Bullish divergence", shape.labelup, location.absolute, C_UP, offset=-pivR, text="Bull", textcolor=color.white, size=size.tiny)
plotshape(bearCond ? roc[pivR] : na, "Bearish divergence", shape.labeldown, location.absolute, C_DN, offset=-pivR, text="Bear", textcolor=color.white, size=size.tiny)

// ───────────────────────── Alerts
alertcondition(ta.crossover(roc, 0),    "ROC+ crossed above zero",   "ROC+ crossed above zero on {{ticker}} {{interval}}")
alertcondition(ta.crossunder(roc, 0),   "ROC+ crossed below zero",   "ROC+ crossed below zero on {{ticker}} {{interval}}")
alertcondition(ta.crossover(roc, sig),  "ROC+ crossed above signal", "ROC+ crossed above its signal on {{ticker}} {{interval}}")
alertcondition(ta.crossunder(roc, sig), "ROC+ crossed below signal", "ROC+ crossed below its signal on {{ticker}} {{interval}}")
crossUp = ta.crossover(roc, upper)
crossLo = ta.crossunder(roc, lower)
alertcondition(crossUp, "ROC+ entered upper band", "ROC+ entered its upper band on {{ticker}} {{interval}}")
alertcondition(crossLo, "ROC+ entered lower band", "ROC+ entered its lower band on {{ticker}} {{interval}}")
alertcondition(bullCond, "ROC+ bullish divergence", "ROC+ bullish divergence on {{ticker}} {{interval}}")
alertcondition(bearCond, "ROC+ bearish divergence", "ROC+ bearish divergence on {{ticker}} {{interval}}")
