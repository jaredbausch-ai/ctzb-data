//@version=6
// =============================================================================
//  CT RSI ZONE BOUNCE - ETH 2D  |  v3 COMPACT
// -----------------------------------------------------------------------------
//  SYMBOL KEY
//    A  teal    bounce off BEARISH CONTROL (<40)
//    B  blue    bounce off NEUTRAL LINE (40-55)
//    C  purple  bounce off BULL-ZONE BASE (55-65)
//    D  orange  dip inside BULL CONTROL (>65)
//    gold fill + diamond  = CT/Stoch trough DISAGREEMENT (the good one)
//    dot under the letter = stoch K 20-50 at trough (prime, bucket A)
//  Hover any marker for the full stats. Nothing else is written on the chart.
// =============================================================================

indicator("CT Zone Bounce v3", shorttitle="CTZB", overlay=false, max_labels_count=500, max_lines_count=500)

// ---------------------------------------------------------------- INPUTS ----
grpI = "Indicator settings"
rsiLen   = input.int(14, "CT RSI length", group=grpI, minval=2)
rsiSrc   = input.source(close, "CT RSI source", group=grpI)
sigLen   = input.int(14, "CT RSI signal line", group=grpI, minval=1)
stochLen = input.int(14, "Stoch RSI length", group=grpI, minval=2)
smoothK  = input.int(3, "Stoch %K smoothing", group=grpI, minval=1)
smoothD  = input.int(3, "Stoch %D smoothing", group=grpI, minval=1)

grpZ = "Zone brackets"
bSplit = input.float(55, "A/B vs C split", group=grpZ)
dSplit = input.float(65, "C vs D split", group=grpZ)
zBear  = input.float(40, "Bearish control ceiling", group=grpZ)

grpP = "Pivot detection"
pvLeft  = input.int(3, "Pivot left bars", group=grpP, minval=1)
pvRight = input.int(3, "Pivot right bars", group=grpP, minval=1)

grpC = "Regime  -  when are you allowed to be long?"
opAuto = "Bull since cycle low (auto)"
opDate = "Bull since my date"
opBull = "Always BULL"
opBear = "Always BEAR"
opCal  = "Calendar windows (backtest)"
regMode = input.string(opAuto, "Regime source", options=[opAuto, opDate, opBull, opBear, opCal], group=grpC)
lowLook    = input.int(250, "Auto: lookback bars for the cycle low", group=grpC, minval=20)
minRecover = input.float(25, "Auto: % recovery off the low to call it bull", group=grpC, minval=0)
minBarsLow = input.int(10, "Auto: bars the low must hold before flipping", group=grpC, minval=0)
bullSince  = input.time(timestamp("2026-06-24T00:00"), "Manual: bull starts here", group=grpC)
b1s = input.time(timestamp("2014-12-04T00:00"), "Calendar: Bull 1 start", group=grpC)
b1e = input.time(timestamp("2017-12-17T00:00"), "Calendar: Bull 1 end", group=grpC)
b2s = input.time(timestamp("2018-12-17T00:00"), "Calendar: Bull 2 start", group=grpC)
b2e = input.time(timestamp("2021-11-10T00:00"), "Calendar: Bull 2 end", group=grpC)
b3s = input.time(timestamp("2022-11-10T00:00"), "Calendar: Bull 3 start", group=grpC)
b3e = input.time(timestamp("2025-10-06T00:00"), "Calendar: Bull 3 end", group=grpC)

grpD = "Display"
markerMode = input.string("Symbol", "Marker detail", options=["Symbol","Symbol + hit rate","Full text"], group=grpD)
waitClose  = input.bool(true, "Print only after the confirmation candle CLOSES", group=grpD)
horizon    = input.string("60d", "Stats horizon", options=["20d","40d","60d","90d","120d"], group=grpD)
bs18 = "2018-2025 (recommended)"
bsAll = "All cycles 2016-2025"
bs22 = "2022-2025 only"
statBasis  = input.string(bs18, "Stats basis", options=[bs18, bsAll, bs22], group=grpD)
disOnly    = input.bool(false, "Show ONLY disagreement signals", group=grpD)
showOff    = input.bool(true, "Ghost bear-year signals (lowercase, grey)", group=grpD)
dimAligned = input.bool(true, "Dim aligned signals", group=grpD)
showConnect= input.bool(false, "Connector line to prior trough", group=grpD)
showStoch  = input.bool(true, "Plot Stoch RSI", group=grpD)
showLegend = input.bool(true, "Show legend", group=grpD)
lpTR = "Top right"
lpBR = "Bottom right"
lpBL = "Bottom left"
lpMR = "Middle right"
legendPos  = input.string(lpTR, "Legend position", options=[lpTR, lpBR, lpBL, lpMR], group=grpD)
legendSize = input.string("Large", "Legend text size", options=["Small","Medium","Large","Huge"], group=grpD)

// ------------------------------------------------------------ CALCULATION ---
ctRsi  = ta.rsi(rsiSrc, rsiLen)
ctSig  = ta.ema(ctRsi, sigLen)
stochV = ta.stoch(ctRsi, ctRsi, ctRsi, stochLen)
kLine  = ta.sma(stochV, smoothK)
dLine  = ta.sma(kLine, smoothD)

inWin(int s, int e) =>
    time >= s and time <= e

// --- regime resolution -------------------------------------------------------
lowOff   = ta.lowestbars(close, lowLook)
barsLow  = na(lowOff) ? 0 : -lowOff
lowPx    = ta.lowest(close, lowLook)
lowTime  = barsLow >= 0 ? time[barsLow] : time
recovPct = lowPx > 0 ? (close / lowPx - 1) * 100 : 0.0
autoBull = barsLow >= minBarsLow and recovPct >= minRecover

calBull = inWin(b1s, b1e) or inWin(b2s, b2e) or inWin(b3s, b3e)

regimeOK = autoBull
if regMode == opDate
    regimeOK := time >= bullSince
else if regMode == opBull
    regimeOK := true
else if regMode == opBear
    regimeOK := false
else if regMode == opCal
    regimeOK := calBull

inBull = regimeOK

// ------------------------------------------------------------ ZONE BANDS ----
p100 = hline(100, "", color=color.new(color.gray, 85))
pBul = hline(60, "Bull control floor", color=color.new(color.teal, 55))
pMid = hline(50, "Neutral line", color=color.new(color.gray, 45), linestyle=hline.style_dashed)
pBer = hline(40, "Bear control ceiling", color=color.new(color.red, 55))
p0   = hline(0, "", color=color.new(color.gray, 85))
fill(pBul, p100, color=color.new(color.teal, 93), title="Bull control zone")
fill(pMid, pBul, color=color.new(color.teal, 97), title="Neutral bullish")
fill(pBer, pMid, color=color.new(color.red, 97), title="Neutral bearish")
fill(p0, pBer, color=color.new(color.red, 93), title="Bear control zone")

plot(ctRsi, "CT RSI", color=color.new(#7E57C2, 0), linewidth=2)
plot(ctSig, "Signal", color=color.new(color.orange, 45))
plot(showStoch ? kLine : na, "Stoch %K", color=color.new(color.blue, 60))
plot(showStoch ? dLine : na, "Stoch %D", color=color.new(color.red, 70))

// -------------------------------------------------------- PIVOT DETECTION ---
pv = ta.pivotlow(ctRsi, pvLeft, pvRight)
isPivot = not na(pv)
troughK = kLine[pvRight]
pvBar = bar_index - pvRight
bucket = isPivot ? (pv < zBear ? "A" : pv < bSplit ? "B" : pv < dSplit ? "C" : "D") : "-"

// ------------------------------------------- TROUGH-TO-TROUGH DISAGREEMENT ---
var float prevCt = na
var float prevK = na
var int prevBar = na

signalBar = isPivot and regimeOK
hasPrev = signalBar and not na(prevCt)
dCt = hasPrev ? pv - prevCt : na
dK  = hasPrev ? troughK - prevK : na
disagree = hasPrev and ((dCt > 0 and dK < 0) or (dCt < 0 and dK > 0))
prime = isPivot and troughK >= 20 and troughK < 50

// -------------------------------------------------------- HISTORICAL STATS ---
pickH(string h, float v20, float v40, float v60, float v90, float v120) =>
    float r = v120
    if h == "20d"
        r := v20
    else if h == "40d"
        r := v40
    else if h == "60d"
        r := v60
    else if h == "90d"
        r := v90
    r

recent = statBasis != bsAll
only3  = statBasis == bs22

hitStat(bool dis, string h) =>
    float r = 0.0
    if not recent
        r := dis ? pickH(h, 61.0, 73.0, 88.0, 82.0, 76.0) : pickH(h, 55.0, 62.0, 62.0, 67.0, 63.0)
    else
        r := dis ? pickH(h, 56.0, 68.0, 88.0, 84.0, 76.0) : pickH(h, 50.0, 60.0, 63.0, 65.0, 62.0)
    r

upMedStat(bool dis, string h) =>
    float r = 0.0
    if not recent
        r := dis ? pickH(h, 14.2, 36.3, 53.3, 73.4, 78.8) : pickH(h, 13.4, 22.3, 33.8, 48.8, 63.0)
    else
        r := dis ? pickH(h, 14.2, 30.0, 43.6, 66.4, 74.7) : pickH(h, 10.3, 19.8, 31.9, 46.2, 57.5)
    r

upAvgStat(bool dis, string h) =>
    float r = 0.0
    if not recent
        r := dis ? pickH(h, 28.7, 57.0, 93.4, 186.4, 323.7) : pickH(h, 22.1, 41.6, 61.9, 90.6, 139.3)
    else
        r := dis ? pickH(h, 20.0, 37.5, 54.2, 73.7, 93.5) : pickH(h, 18.1, 29.2, 42.3, 61.4, 82.0)
    r

hitBk(string b, string h) =>
    float r = 0.0
    if not recent
        if b == "A"
            r := pickH(h, 40.0, 57.0, 71.0, 74.0, 74.0)
        else if b == "B"
            r := pickH(h, 63.0, 65.0, 69.0, 68.0, 60.0)
        else if b == "C"
            r := pickH(h, 52.0, 68.0, 64.0, 68.0, 68.0)
        else
            r := pickH(h, 77.0, 77.0, 69.0, 85.0, 77.0)
    else if only3
        if b == "A"
            r := pickH(h, 41.0, 59.0, 71.0, 71.0, 71.0)
        else if b == "B"
            r := pickH(h, 58.0, 54.0, 62.0, 62.0, 54.0)
        else if b == "C"
            r := pickH(h, 44.0, 67.0, 56.0, 56.0, 67.0)
        else
            r := pickH(h, 50.0, 50.0, 50.0, 50.0, 50.0)
    else
        if b == "A"
            r := pickH(h, 39.0, 55.0, 71.0, 71.0, 71.0)
        else if b == "B"
            r := pickH(h, 60.0, 63.0, 71.0, 71.0, 62.0)
        else if b == "C"
            r := pickH(h, 48.0, 67.0, 62.0, 62.0, 67.0)
        else
            r := pickH(h, 57.0, 71.0, 57.0, 71.0, 57.0)
    r

upMedBk(string b, string h) =>
    float r = 0.0
    if not recent
        if b == "A"
            r := pickH(h, 9.9, 17.2, 33.2, 49.3, 70.1)
        else if b == "B"
            r := pickH(h, 13.5, 29.3, 37.5, 50.4, 62.3)
        else if b == "C"
            r := pickH(h, 19.4, 23.6, 37.9, 53.5, 72.5)
        else
            r := pickH(h, 40.2, 62.2, 62.2, 107.2, 228.9)
    else if only3
        if b == "A"
            r := pickH(h, 9.5, 15.3, 31.6, 44.0, 55.0)
        else if b == "B"
            r := pickH(h, 8.6, 18.0, 25.4, 35.0, 44.0)
        else if b == "C"
            r := pickH(h, 12.0, 15.0, 19.0, 30.0, 38.0)
        else
            r := pickH(h, 6.0, 9.0, 11.0, 20.0, 28.0)
    else
        if b == "A"
            r := pickH(h, 9.9, 15.8, 31.7, 48.1, 61.9)
        else if b == "B"
            r := pickH(h, 11.3, 29.0, 38.0, 53.3, 63.0)
        else if b == "C"
            r := pickH(h, 16.4, 20.9, 31.7, 44.7, 57.1)
        else
            r := pickH(h, 7.1, 21.2, 34.4, 57.0, 82.5)
    r

bucketName(string b) =>
    string r = "Dip inside bull control (>65)"
    if b == "A"
        r := "Bounce off bearish control (<40)"
    else if b == "B"
        r := "Bounce off neutral line (40-55)"
    else if b == "C"
        r := "Bounce off bull-zone base (55-65)"
    r

bucketCol(string b) =>
    color r = #FFA726
    if b == "A"
        r := #26A69A
    else if b == "B"
        r := #42A5F5
    else if b == "C"
        r := #AB47BC
    r

// ------------------------------------------------------------- SIGNAL PLOT --
barOK = barstate.isconfirmed or not waitClose
passFilter = not disOnly or disagree
drawIt = isPivot and (regimeOK or showOff) and passFilter and barOK

hitShow = hasPrev ? hitStat(disagree, horizon) : hitBk(bucket, horizon)
upShow  = hasPrev ? upMedStat(disagree, horizon) : upMedBk(bucket, horizon)
avgShow = hasPrev ? upAvgStat(disagree, horizon) : upMedBk(bucket, horizon)

if drawIt
    // ---- on-chart text: kept to a symbol ----
    string sym = regimeOK ? bucket : str.lower(bucket)
    if disagree and regimeOK
        sym := "◆" + sym
    if prime and regimeOK
        sym := sym + "·"
    string shown = sym
    if markerMode == "Symbol + hit rate"
        shown := sym + " " + str.tostring(hitShow, "#") + "%"
    else if markerMode == "Full text"
        shown := sym + " " + str.tostring(hitShow, "#") + "% / +" + str.tostring(upShow, "#") + "%"

    // ---- everything else lives in the hover tooltip ----
    string t1 = (disagree ? "◆ DISAGREEMENT" : "aligned") + "   |   " + bucket + " - " + bucketName(bucket) + "\n"
    string t2 = ""
    if disagree
        t2 := (dCt > 0 ? "CT higher low + stoch deeper reset" : "CT lower low + stoch higher reset") + "\n"
    string t3p = hasPrev ? "   (prev " + str.tostring(prevCt, "#.#") + ")" : ""
    string t3 = "CT trough  " + str.tostring(pv, "#.#") + t3p + "\n"
    string t4p = hasPrev ? "   (prev " + str.tostring(prevK, "#.#") + ")" : ""
    string t4 = "Stoch K    " + str.tostring(troughK, "#.#") + t4p + "\n"
    string t5 = prime ? "· stoch 20-50 at trough (prime)\n" : ""
    string t6 = "\nHISTORICAL, " + horizon + ", n=" + (hasPrev ? (disagree ? "33" : "104") : "-") + "\n"
    string t7 = "Hit rate      " + str.tostring(hitShow, "#") + "%\n"
    string t8 = "Upside med  +" + str.tostring(upShow, "#.#") + "%\n"
    string t9 = "Upside avg  +" + str.tostring(avgShow, "#.#") + "%"
    string tip = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9

    int trans = (dimAligned and not disagree) ? 45 : 0
    color bg = disagree ? color.new(#FFD54F, trans) : color.new(bucketCol(bucket), trans)
    color tc = disagree ? color.black : color.white
    if not regimeOK
        bg := color.new(color.gray, 75)
        tc := color.new(color.silver, 20)
        string bt1 = "BEAR YEAR - do not trade\n"
        string bt2 = bucket + " - " + bucketName(bucket) + "\n"
        string bt3 = "CT trough " + str.tostring(pv, "#.#") + "\n"
        string bt4 = "Stoch K " + str.tostring(troughK, "#.#") + "\n\n"
        string bt5 = "Bear-year hit 60d: A 41%, B 15%\n"
        string bt6 = "Median 60d: A -7%, B -27%"
        tip := bt1 + bt2 + bt3 + bt4 + bt5 + bt6
    label.new(pvBar, pv, text=shown, style=label.style_label_up, color=bg,
       textcolor=tc, size=size.tiny, yloc=yloc.price, tooltip=tip)

    if showConnect and hasPrev
        color lc = disagree ? color.new(#FFD54F, 30) : color.new(color.gray, 80)
        line.new(prevBar, prevCt, pvBar, pv, xloc=xloc.bar_index, color=lc, width=disagree ? 2 : 1, style=line.style_dotted)

diaRow = disagree and regimeOK and passFilter and barOK
plotshape(diaRow, "Disagreement row", shape.diamond, location.bottom,
   color=color.new(#FFD54F, 0), size=size.tiny)
bgcolor(inBull ? color.new(color.teal, 96) : na, title="Bull window shading")

if signalBar and barOK
    prevCt := pv
    prevK := troughK
    prevBar := pvBar

// ----------------------------------------------------------------- ALERTS ---
alertcondition(isPivot and regimeOK, "Any zone bounce", "CTZB signal")
alertcondition(isPivot and regimeOK and disagree, "Disagreement bounce", "CTZB disagreement - 88pct hit 60d")
alertcondition(isPivot and regimeOK and disagree and dCt > 0, "Disagree: CT higher low", "CTZB disagreement, CT higher low")
alertcondition(isPivot and regimeOK and disagree and dCt < 0, "Disagree: CT lower low", "CTZB disagreement, CT lower low")
alertcondition(isPivot and regimeOK and bucket == "A", "A signal", "CTZB A")
alertcondition(isPivot and regimeOK and bucket == "B", "B signal", "CTZB B")
alertcondition(isPivot and regimeOK and bucket == "C", "C signal", "CTZB C")
alertcondition(isPivot and regimeOK and bucket == "D", "D signal", "CTZB D")

// ----------------------------------------------------------------- LEGEND ---
legPos = legendPos == lpBR ? position.bottom_right : legendPos == lpBL ? position.bottom_left : legendPos == lpMR ? position.middle_right : position.top_right

// legend type scale — "Large" is roughly double the old default
symSize = legendSize == "Small" ? size.small : legendSize == "Medium" ? size.normal : legendSize == "Huge" ? size.huge : size.large
txtSize = legendSize == "Small" ? size.tiny : legendSize == "Medium" ? size.small : legendSize == "Huge" ? size.large : size.normal
var table lg = table.new(legPos, 3, 8, border_width=1, frame_width=1, frame_color=color.new(color.gray, 50))

lgSym(int r, string s, color bg, color tx) =>
    table.cell(lg, 0, r, s, text_color=tx, bgcolor=bg, text_size=symSize)

lgTxt(int r, int c, string s) =>
    table.cell(lg, c, r, s, text_color=color.silver, bgcolor=color.new(color.black, 60), text_size=txtSize)

if showLegend and barstate.islast
    string regTxt = inBull ? "BULL - signals live" : "BEAR - signals ghosted"
    string regSub = ""
    if regMode == opAuto
        string sLow = str.format_time(lowTime, "yyyy-MM-dd")
        string sRec = str.tostring(recovPct, "#")
        regSub := "low " + sLow + "  +" + sRec + "%  " + str.tostring(barsLow * 2) + "d ago"
    else if regMode == opDate
        regSub := "manual from " + str.format_time(bullSince, "yyyy-MM-dd")
    else if regMode == opCal
        regSub := "calendar windows"
    else
        regSub := "forced"
    color regBg = inBull ? color.new(color.teal, 10) : color.new(color.red, 40)
    color regTc = inBull ? color.black : color.white
    table.cell(lg, 0, 0, inBull ? "BULL" : "BEAR", text_color=regTc, bgcolor=regBg, text_size=symSize)
    table.cell(lg, 1, 0, regSub, text_color=color.silver, bgcolor=color.new(color.black, 60), text_size=txtSize)
    table.merge_cells(lg, 1, 0, 2, 0)
    table.cell(lg, 0, 1, "", bgcolor=color.new(color.black, 60), text_size=txtSize)
    color hdC = color.new(color.silver, 30)
    color hdB = color.new(color.black, 60)
    table.cell(lg, 1, 1, "Hit " + horizon, text_color=hdC, bgcolor=hdB, text_size=txtSize)
    table.cell(lg, 2, 1, "Upside", text_color=hdC, bgcolor=hdB, text_size=txtSize)
    lgSym(2, "◆", color.new(#FFD54F, 0), color.black)
    lgTxt(2, 1, str.tostring(hitStat(true, horizon), "#") + "%")
    lgTxt(2, 2, "+" + str.tostring(upMedStat(true, horizon), "#") + "%")
    lgSym(3, "A", color.new(#26A69A, 0), color.white)
    lgTxt(3, 1, str.tostring(hitBk("A", horizon), "#") + "%")
    lgTxt(3, 2, "+" + str.tostring(upMedBk("A", horizon), "#") + "%")
    lgSym(4, "B", color.new(#42A5F5, 0), color.white)
    lgTxt(4, 1, str.tostring(hitBk("B", horizon), "#") + "%")
    lgTxt(4, 2, "+" + str.tostring(upMedBk("B", horizon), "#") + "%")
    lgSym(5, "C", color.new(#AB47BC, 0), color.white)
    lgTxt(5, 1, str.tostring(hitBk("C", horizon), "#") + "%")
    lgTxt(5, 2, "+" + str.tostring(upMedBk("C", horizon), "#") + "%")
    lgSym(6, "D", color.new(#FFA726, 0), color.white)
    lgTxt(6, 1, str.tostring(hitBk("D", horizon), "#") + "%")
    lgTxt(6, 2, "+" + str.tostring(upMedBk("D", horizon), "#") + "%")
    table.cell(lg, 0, 7, "basis", text_color=color.new(color.silver, 40), bgcolor=color.new(color.black, 60), text_size=txtSize)
    string bTxt = only3 ? "2022-25" : (recent ? "2018-25" : "2016-25")
    table.cell(lg, 1, 7, bTxt, text_color=color.new(color.silver, 40), bgcolor=color.new(color.black, 60), text_size=txtSize)
    table.merge_cells(lg, 1, 7, 2, 7)
