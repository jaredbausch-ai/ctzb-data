//@version=5
// ============================================================================
// BTC CYCLE CLOCK v2
// ----------------------------------------------------------------------------
// WHAT IT IS
//   One line: the share of historical bars at this cycle position that closed
//   higher N days later. Above the baseline is better than knowing nothing,
//   below is worse. The grey line to the right of price is the same record
//   read forward - cycle position advances one day per day with certainty, so
//   the historical figure for every future date is already fixed. That is a
//   lookup, not a forecast.
//
// WHY v2 EXISTS - THE ANCHOR WAS WRONG
//   v1 counted days since the all-time high. That assumes every cycle runs on
//   the same schedule, and this one does not:
//
//        cycle        bear (ATH->low)    bull (low->ATH)    total
//        2013-2017         406              1068            1474
//        2017-2021         363              1061            1424
//        2021-2025         376              1050            1426
//        current           261                 ?               ?
//
//   The BULL leg is the stable part - 1050 to 1068 days, a 2% spread. The
//   BEAR leg varies 11%, and the current one came in at 261 days, roughly a
//   hundred days short. An ATH-anchored clock therefore reads the current
//   cycle about a hundred days behind where it structurally is.
//
//   Measured against 90-day forward direction on BTC 2014-2026:
//        days since ATH      r = +0.398   spread 41pp
//        days since LOW      r = -0.227   spread 42pp
//        phase of ATH-to-ATH r = +0.390   spread 40pp
//
//   The low anchor measures as well as the ATH anchor and does not assume the
//   bear length. Phase normalisation adds nothing, because cycle length is
//   already stable at 1424-1474 days - there is nothing to normalise away.
//   So v2 defaults to the LOW anchor and keeps the ATH one as a toggle.
//
// WHAT THE TWO CLOCKS SAY TODAY
//   They disagree, and the disagreement is the point. The ATH clock has you
//   early-cycle; the low clock knows you have already bottomed.
//
// THE HONEST LIMITS
//   THREE CYCLES. Every bucket is two or three overlapping windows wearing a
//   few hundred bars. The 100% cells are three events. Shape real, precision
//   fake.
//
//   THE CURRENT LOW IS A CALL, NOT A FACT. 2026-06-24 is an input. If price
//   takes it out, the clock is wrong and needs re-anchoring.
//
//   SURVIVORSHIP. Bitcoin rose across all four cycles. A calendar measured on
//   an asset that went up 10,000,000x finds that most calendar positions were
//   good.
//
//   CONTEXT for sizing and patience. Not a signal, and it says nothing about
//   any individual entry.
// ============================================================================
indicator("BTC Cycle Clock v2", shorttitle="CYCLE-CLOCK", overlay=false)

gA = "Anchors"
anchorMode = input.string("Cycle low", "Count days since", options=["Cycle low","All-time high"], group=gA)
l1 = input.time(timestamp("2015-01-14T00:00"), "Low 1", group=gA)
l2 = input.time(timestamp("2018-12-15T00:00"), "Low 2", group=gA)
l3 = input.time(timestamp("2022-11-21T00:00"), "Low 3", group=gA)
l4 = input.time(timestamp("2026-06-24T00:00"), "Low 4 (current - your call)", group=gA)
a1 = input.time(timestamp("2013-12-04T00:00"), "ATH 1", group=gA)
a2 = input.time(timestamp("2017-12-17T00:00"), "ATH 2", group=gA)
a3 = input.time(timestamp("2021-11-10T00:00"), "ATH 3", group=gA)
a4 = input.time(timestamp("2025-10-06T00:00"), "ATH 4", group=gA)

gD = "Display"
hz       = input.string("90d", "Horizon", options=["30d","60d","90d"], group=gD)
leadDays = input.int(180, "Project the curve forward (days)", minval=0, maxval=400, group=gD)
showFwd  = input.bool(true, "Show the forward projection", group=gD)
showOther= input.bool(true, "Show the other anchor as a faint line", group=gD)

// ---- baselines measured on the same bars ----
baseRate = hz == "30d" ? 57.0 : hz == "60d" ? 58.0 : 60.0

// ---- days since each anchor ----
msDay = 86400000.0
lastLow = time >= l4 ? l4 : time >= l3 ? l3 : time >= l2 ? l2 : l1
lastATH = time >= a4 ? a4 : time >= a3 ? a3 : time >= a2 ? a2 : a1
dLow = int(math.floor((time - lastLow) / msDay))
dAth = int(math.floor((time - lastATH) / msDay))
useLow = anchorMode == "Cycle low"
dsa = useLow ? dLow : dAth

minPerBar = timeframe.isminutes ? float(timeframe.multiplier) : timeframe.isdaily ? 1440.0 * timeframe.multiplier : timeframe.isweekly ? 1440.0 * 7 * timeframe.multiplier : 1440.0
barsPerDay = minPerBar > 0 ? 1440.0 / minPerBar : 1.0
leadBars = int(math.max(1, math.round(leadDays * barsPerDay)))

// ============================================================================
// THE MEASURED RECORD. BTC 2014-2026, 60-day buckets.
// Share of bars at that cycle position that closed higher 30/60/90 days later.
// ============================================================================
rateLow(int dd, string h) =>
    int b = dd < 0 ? 0 : int(math.min(18, math.floor(dd / 60)))
    float r = na
    if h == "30d"
        if b == 0
            r := 70.
        else if b == 1
            r := 72.
        else if b == 2
            r := 72.
        else if b == 3
            r := 41.
        else if b == 4
            r := 58.
        else if b == 5
            r := 61.
        else if b == 6
            r := 69.
        else if b == 7
            r := 76.
        else if b == 8
            r := 63.
        else if b == 9
            r := 54.
        else if b == 10
            r := 64.
        else if b == 11
            r := 95.
        else if b == 12
            r := 76.
        else if b == 13
            r := 55.
        else if b == 14
            r := 58.
        else if b == 15
            r := 73.
        else if b == 16
            r := 62.
        else if b == 17
            r := 35.
        else if b == 18
            r := 29.
    else if h == "60d"
        if b == 0
            r := 80.
        else if b == 1
            r := 82.
        else if b == 2
            r := 69.
        else if b == 3
            r := 38.
        else if b == 4
            r := 51.
        else if b == 5
            r := 65.
        else if b == 6
            r := 77.
        else if b == 7
            r := 79.
        else if b == 8
            r := 57.
        else if b == 9
            r := 52.
        else if b == 10
            r := 79.
        else if b == 11
            r := 100.
        else if b == 12
            r := 82.
        else if b == 13
            r := 59.
        else if b == 14
            r := 69.
        else if b == 15
            r := 98.
        else if b == 16
            r := 77.
        else if b == 17
            r := 21.
        else if b == 18
            r := 12.
    else
        if b == 0
            r := 86.
        else if b == 1
            r := 90.
        else if b == 2
            r := 74.
        else if b == 3
            r := 35.
        else if b == 4
            r := 61.
        else if b == 5
            r := 76.
        else if b == 6
            r := 66.
        else if b == 7
            r := 88.
        else if b == 8
            r := 66.
        else if b == 9
            r := 66.
        else if b == 10
            r := 98.
        else if b == 11
            r := 100.
        else if b == 12
            r := 73.
        else if b == 13
            r := 58.
        else if b == 14
            r := 77.
        else if b == 15
            r := 100.
        else if b == 16
            r := 66.
        else if b == 17
            r := 19.
        else if b == 18
            r := 15.
    r

