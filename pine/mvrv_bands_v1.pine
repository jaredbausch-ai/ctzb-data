//@version=6
// MVRV Bands  v1
// Realised-price bands on the price chart, from live on-chain data.
//
// realised price = realised cap / circulating supply
// MVRV          = price / realised price
// A band at multiplier m sits at  realised price * m,  i.e. the price where MVRV = m.
//
// Default band levels come from ETH 5D long-streak work in ctzb-data
// (RESULTS_MVRV.txt, analysis/mvrv.py), verified 8 Nov 2026:
//   five of seven long red streaks since 2016 ended with MVRV between
//   0.789 and 0.932, median 0.848.
//
// Data symbols are INPUTS, not hardcoded. TradingView's on-chain ticker
// strings are undocumented and vary by plan, so pick them with symbol search.
// If realised cap is unavailable, set useSeed and point it at a Pine Seeds
// repo instead.

indicator("MVRV Bands", "MVRV Bands", overlay = true, max_lines_count = 100)

// ---------- data ----------
grpD = "Data"
rcSym  = input.symbol("", "Realised cap symbol", group = grpD,
     tooltip = "Search for the realised market cap series for this asset. Leave blank to use the manual realised price below.")
spSym  = input.symbol("", "Circulating supply symbol", group = grpD,
     tooltip = "Leave blank to estimate supply from market cap / price.")
mcSym  = input.symbol("", "Market cap symbol (supply fallback)", group = grpD)
manRP  = input.float(0.0, "Manual realised price", minval = 0, step = 0.01, group = grpD,
     tooltip = "Used when no realised cap symbol is set. ETH was 2208.78 on 2026-11-07.")

f_get(string sym) =>
    na(sym) or sym == "" ? na : request.security(sym, "D", close, ignore_invalid_symbol = true)

rc = f_get(rcSym)
sp = f_get(spSym)
mc = f_get(mcSym)

// supply fallback: market cap / price
supply = not na(sp) ? sp : (not na(mc) and close > 0 ? mc / close : na)

realised = not na(rc) and not na(supply) and supply > 0 ? rc / supply : (manRP > 0 ? manRP : na)
mvrv     = not na(realised) and realised > 0 ? close / realised : na

// ---------- bands ----------
grpB  = "Bands"
show  = input.bool(true,  "Show bands", group = grpB)
bLo   = input.float(0.789, "Exhaustion floor",   step = 0.001, group = grpB)
bMid  = input.float(0.848, "Exhaustion median",  step = 0.001, group = grpB)
bHi   = input.float(0.932, "Exhaustion ceiling", step = 0.001, group = grpB)
bPar  = input.float(1.000, "Break-even (MVRV 1)", step = 0.001, group = grpB)
bUp1  = input.float(1.400, "Upper 1",            step = 0.001, group = grpB)
bUp2  = input.float(2.000, "Upper 2",            step = 0.001, group = grpB)
bUp3  = input.float(3.000, "Upper 3",            step = 0.001, group = grpB)

pLo  = realised * bLo
pMid = realised * bMid
pHi  = realised * bHi
pPar = realised * bPar
pU1  = realised * bUp1
pU2  = realised * bUp2
pU3  = realised * bUp3

cBand = color.new(#2f7a62, 0)
cPar  = color.new(#8a8f98, 0)
cUp   = color.new(#c2410c, 0)

plLo  = plot(show ? pLo  : na, "Exhaustion floor",   cBand, 1)
plMid = plot(show ? pMid : na, "Exhaustion median",  color.new(#2f7a62, 35), 1, plot.style_linebr)
plHi  = plot(show ? pHi  : na, "Exhaustion ceiling", cBand, 1)
plot(show ? pPar : na, "Break-even", cPar, 1)
plot(show ? pU1  : na, "Upper 1",    color.new(#c2410c, 55), 1)
plot(show ? pU2  : na, "Upper 2",    color.new(#c2410c, 40), 1)
plot(show ? pU3  : na, "Upper 3",    cUp, 1)
fill(plLo, plHi, color.new(#2f7a62, 88), "Exhaustion zone")

plot(show ? realised : na, "Realised price", color.new(#8a8f98, 20), 2)

// ---------- state ----------
inZone  = not na(mvrv) and mvrv >= bLo and mvrv <= bHi
below   = not na(mvrv) and mvrv < bLo
bgcolor(inZone ? color.new(#2f7a62, 92) : below ? color.new(#2f7a62, 84) : na, title = "In zone")

alertcondition(ta.crossunder(mvrv, bHi), "MVRV entered exhaustion zone", "MVRV fell into the historical streak-exit band")
alertcondition(ta.crossunder(mvrv, bLo), "MVRV below exhaustion floor",  "MVRV below the historical streak-exit band")
alertcondition(ta.crossover(mvrv,  bPar), "MVRV back above 1",           "MVRV reclaimed break-even")

// ---------- readout ----------
grpT = "Table"
showT = input.bool(true, "Show readout", group = grpT)
pos   = input.string("Top right", "Position", options = ["Top right","Top left","Bottom right","Bottom left"], group = grpT)
tp = pos == "Top right" ? position.top_right : pos == "Top left" ? position.top_left : pos == "Bottom right" ? position.bottom_right : position.bottom_left

var table t = table.new(tp, 2, 6, border_width = 1)
if showT and barstate.islast
    src = not na(rc) ? "live feed" : manRP > 0 ? "manual" : "none"
    table.cell(t, 0, 0, "MVRV",            text_color = chart.fg_color, text_size = size.small)
    table.cell(t, 1, 0, na(mvrv) ? "n/a" : str.tostring(mvrv, "#.###"),
         text_color = na(mvrv) ? color.gray : inZone ? #2f7a62 : below ? #2f7a62 : chart.fg_color, text_size = size.small)
    table.cell(t, 0, 1, "Realised price",   text_color = chart.fg_color, text_size = size.small)
    table.cell(t, 1, 1, na(realised) ? "n/a" : str.tostring(realised, format.mintick), text_size = size.small)
    table.cell(t, 0, 2, "Zone ceiling",     text_color = chart.fg_color, text_size = size.small)
    table.cell(t, 1, 2, na(pHi) ? "n/a" : str.tostring(pHi, format.mintick) + "  (" + (na(mvrv) ? "" : str.tostring((pHi/close-1)*100, "#.#")) + "%)", text_size = size.small)
    table.cell(t, 0, 3, "Zone median",      text_color = chart.fg_color, text_size = size.small)
    table.cell(t, 1, 3, na(pMid) ? "n/a" : str.tostring(pMid, format.mintick) + "  (" + (na(mvrv) ? "" : str.tostring((pMid/close-1)*100, "#.#")) + "%)", text_size = size.small)
    table.cell(t, 0, 4, "Zone floor",       text_color = chart.fg_color, text_size = size.small)
    table.cell(t, 1, 4, na(pLo) ? "n/a" : str.tostring(pLo, format.mintick) + "  (" + (na(mvrv) ? "" : str.tostring((pLo/close-1)*100, "#.#")) + "%)", text_size = size.small)
    table.cell(t, 0, 5, "Source",           text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 5, src, text_color = src == "none" ? color.red : color.gray, text_size = size.tiny)
