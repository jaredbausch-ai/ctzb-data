//@version=6
// Early Appetite (Leading) — v2
//
// Rebuild of the v1 baseline. What changed and why:
//
// 1. CALENDAR. v1 pulled HYG, LQD, VIX3M and VIX at timeframe.period. On a 2D
//    crypto chart those bars span weekends while the equity symbols trade a
//    five-day week, so a 20-bar rate of change was measuring inconsistent
//    spans. v2 requests every component at "D" regardless of chart timeframe,
//    so the momentum window is always the same number of trading days.
//
// 2. SILENT DEGRADATION. v1 renormalised over whatever resolved. If HYG was
//    unavailable on your plan the composite quietly became a two-component
//    line with no indication. v2 shows the component count and marks each one
//    live / missing in the table.
//
// 3. CAPPING. Components are clipped at +/- zcap. If one is pinned at the cap
//    the composite understates it. v2 flags any capped component.
//
// 4. "LOWEST EVER" vs the window. v1's z used a fixed 252-bar lookback, so an
//    extreme is relative to the trailing window only. v2 adds an EXPANDING
//    window option that scores against all history on the chart, and reports
//    each component's percentile rank so you can see how rare a reading is
//    rather than inferring it from the sigma value.
//
// 5. UNITS. v1 plotted the composite and its slope on one scale; they are not
//    the same units. v2 puts the slope in its own display, scaled.

indicator("Early Appetite v2", "Appetite", overlay = false)

// ====================== inputs ======================
string zmode = input.string("Rolling 252", "Z-score window",
     options = ["Rolling 126", "Rolling 252", "Rolling 504", "Expanding (all history)"], group = "Core")
int   momLen   = input.int(20, "Momentum lookback (days)", minval = 2, group = "Core")
int   slopeLen = input.int(10, "Direction window (days)",  minval = 2, group = "Core")
int   smoothLen= input.int(5,  "Composite smoothing",      minval = 1, group = "Core")
float zcap     = input.float(3.0, "Z cap (sigma)", minval = 1.0, maxval = 5.0, step = 0.5, group = "Core")

string hygSym  = input.symbol("AMEX:HYG",       "High-yield ETF",  group = "Symbols")
string lqdSym  = input.symbol("AMEX:LQD",       "Inv-grade ETF",   group = "Symbols")
string vix3Sym = input.symbol("CBOE:VIX3M",     "VIX 3-month",     group = "Symbols")
string vixSym  = input.symbol("TVC:VIX",        "VIX spot",        group = "Symbols")
string usdtSym = input.symbol("CRYPTOCAP:USDT", "Stablecoin cap",  group = "Symbols")

float wCredit = input.float(0.40, "Weight credit",      minval = 0, maxval = 1, step = 0.05, group = "Weights")
float wVix    = input.float(0.30, "Weight VIX term",    minval = 0, maxval = 1, step = 0.05, group = "Weights")
float wStable = input.float(0.30, "Weight stablecoin",  minval = 0, maxval = 1, step = 0.05, group = "Weights")
bool  invStable = input.bool(false, "Invert stablecoin sign", group = "Weights")

// ====================== helpers ======================
// Always daily, whatever the chart is on.
S(string sym) => request.security(sym, "D", close, lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true)

zlenOf() =>
    int out = 252
    if zmode == "Rolling 126"
        out := 126
    else if zmode == "Rolling 504"
        out := 504
    else if zmode == "Expanding (all history)"
        out := 100000
    out

int zlen = zlenOf()

// raw z before capping, so we can tell whether the cap bit
zraw(float src, int len) =>
    int n = math.min(len, bar_index + 1)
    float m = ta.sma(src, n)
    float s = ta.stdev(src, n)
    s == 0 or na(s) ? na : (src - m) / s

prank(float src, int len) =>
    int n = math.min(len, bar_index + 1)
    n < 20 ? na : ta.percentrank(src, n)

// ====================== components ======================
float hyg = S(hygSym)
float lqd = S(lqdSym)
float creditRatio = na(hyg) or na(lqd) or lqd == 0 ? na : hyg / lqd
float creditMom = na(creditRatio) ? na : ta.roc(creditRatio, momLen)
float creditRaw = zraw(creditMom, zlen)
float creditZ = na(creditRaw) ? na : math.max(math.min(creditRaw, zcap), -zcap)
float creditP = prank(creditMom, zlen)

float vix3 = S(vix3Sym)
float vixs = S(vixSym)
float vixTerm = na(vix3) or na(vixs) or vixs == 0 ? na : vix3 / vixs
float vixRaw = zraw(vixTerm, zlen)
float vixZ = na(vixRaw) ? na : math.max(math.min(vixRaw, zcap), -zcap)
float vixP = prank(vixTerm, zlen)

float usdt = S(usdtSym)
float usdtG = na(usdt) ? na : ta.roc(usdt, momLen)
float stableRaw0 = zraw(usdtG, zlen)
float stableRaw = na(stableRaw0) ? na : (invStable ? -stableRaw0 : stableRaw0)
float stableZ = na(stableRaw) ? na : math.max(math.min(stableRaw, zcap), -zcap)
float stableP = na(usdtG) ? na : (invStable ? 100 - prank(usdtG, zlen) : prank(usdtG, zlen))

// ====================== composite ======================
float num = 0.0
float den = 0.0
int   live = 0
if not na(creditZ)
    num += creditZ * wCredit
    den += wCredit
    live += 1
if not na(vixZ)
    num += vixZ * wVix
    den += wVix
    live += 1
if not na(stableZ)
    num += stableZ * wStable
    den += wStable
    live += 1

float appetiteRaw = den > 0 ? num / den : na
float appetite = ta.sma(appetiteRaw, smoothLen)
float slope = appetite - appetite[slopeLen]
float appetiteP = prank(appetiteRaw, zlen)

bool capped = (not na(creditRaw) and math.abs(creditRaw) > zcap) or (not na(vixRaw) and math.abs(vixRaw) > zcap) or (not na(stableRaw) and math.abs(stableRaw) > zcap)

// ====================== plot ======================
bool showSlope = input.bool(true, "Show direction histogram", group = "Display")
bool showComp  = input.bool(false, "Show component z-scores", group = "Display")
float slopeScale = input.float(1.0, "Direction histogram scale", minval = 0.1, step = 0.1, group = "Display")

color cUp = #2f9e78
color cDn = #c2410c
color lineCol = slope >= 0 ? cUp : cDn

plot(showSlope ? slope * slopeScale : na, "Direction", color.new(slope >= 0 ? cUp : cDn, 60), 1, plot.style_columns)
plot(appetite, "Appetite (sigma)", lineCol, 3)
plot(showComp ? creditZ : na, "Credit z",     color.new(#e07a3f, 35))
plot(showComp ? vixZ    : na, "VIX term z",   color.new(#8a5cf6, 35))
plot(showComp ? stableZ : na, "Stablecoin z", color.new(#3b82f6, 35))

hline(0,  "Neutral", color.gray)
hline(1,  "+1", color.new(cUp, 60), hline.style_dashed)
hline(-1, "-1", color.new(cDn, 60), hline.style_dashed)
hline(2,  "+2", color.new(cUp, 80), hline.style_dotted)
hline(-2, "-2", color.new(cDn, 80), hline.style_dotted)

// ====================== readout ======================
bool showTable = input.bool(true, "Show table", group = "Display")

fmtZ(float z, float p, bool ok) =>
    string s = "missing"
    if ok and not na(z)
        s := str.tostring(z, "#.##") + "   " + (na(p) ? "-" : str.tostring(p, "#") + "pct")
    s

var table t = table.new(position.top_right, 2, 7, border_width = 1)
if showTable and barstate.islast
    color aCol = na(appetite) ? color.gray : appetite <= -1 ? cDn : appetite >= 1 ? cUp : chart.fg_color
    table.cell(t, 0, 0, "Appetite", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, na(appetite) ? "n/a" : str.tostring(appetite, "#.##") + " sigma", text_color = aCol, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 0, 1, "Percentile", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 1, na(appetiteP) ? "n/a" : str.tostring(appetiteP, "#.#") + "%", text_color = aCol, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 0, 2, "Direction", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 2, na(slope) ? "n/a" : (slope > 0 ? "rising " : slope < 0 ? "falling " : "flat ") + str.tostring(slope, "#.##"), text_color = slope >= 0 ? cUp : cDn, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 0, 3, "Credit",     text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 3, fmtZ(creditZ, creditP, not na(creditZ)), text_color = na(creditZ) ? color.red : chart.fg_color, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 0, 4, "VIX term",   text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 4, fmtZ(vixZ, vixP, not na(vixZ)), text_color = na(vixZ) ? color.red : chart.fg_color, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 0, 5, "Stablecoin", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 5, fmtZ(stableZ, stableP, not na(stableZ)), text_color = na(stableZ) ? color.red : chart.fg_color, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 0, 6, "Inputs live", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 6, str.tostring(live) + "/3" + (capped ? "  CAPPED" : "") + "   " + zmode, text_color = live < 3 or capped ? color.red : color.gray, text_size = size.tiny, text_halign = text.align_right)

alertcondition(ta.crossunder(appetite, -1.0), "Appetite below -1 sigma", "Risk appetite turned risk-off")
alertcondition(ta.crossover(appetite,  -1.0), "Appetite back above -1",  "Risk appetite recovering")
alertcondition(ta.crossunder(slope, 0.0),     "Appetite direction turned down", "Appetite slope crossed below zero")
alertcondition(ta.crossover(slope,  0.0),     "Appetite direction turned up",   "Appetite slope crossed above zero")
