//@version=6
// CTZB Backdrop — ROC+ band strip. Statistics lab (stats-lab branch), 25 Nov 2026.
// For Jared only. State only: no percentages, nothing to go stale.
// v6, 25 Nov 2026: rate of change ONLY (Jared). The ct40 read (5D CTZB turn under CT 40)
// that v1-v5 carried is removed; it was never asked for here.
//
// The read: ROC+ on the 5D chart (Percent ROC, 9 bars), lower band = 10th percentile of the
// last 250 bars, closed 5D bars only.
//   track   solid for 60 days after the latest closed 5D bar outside the band (lab/rocband.py)
//   "band"  the first closed 5D bar outside the band, each time it goes out
//   "turn"  the first closed 5D bar back inside the band after that
// Watch item, not a lens: tested on ETH only (BTC showed no effect). Entry quality only.
indicator("CTZB Backdrop", shorttitle="Backdrop", overlay=false, format=format.price, precision=0, max_bars_back=500, max_labels_count=500)

G = "Backdrop"
tf5       = input.timeframe("5D", "Timeframe of the read", group=G)
bandDays  = input.int(60, "Band window, days", minval=1, group=G)
showMarks = input.bool(true, "Band / turn markers on the price chart", group=G)
showTable = input.bool(true, "Show the status table", group=G)
tblPos    = input.string("Top right", "Table position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=G)

DAY = 86400000

// off = 0: this 5D bar; off = 1: the one before
readBand(int off) =>
    float r = 100 * (close - close[9]) / close[9]
    float lb = ta.percentile_nearest_rank(r, 250, 10)
    bool below = not na(r) and not na(lb) and r < lb
    [below[off], time_close[off]]

// Lookahead on, so each value belongs to the 5D bar it came from. The 5D bar that holds this
// chart bar is used only when it closes at or before this chart bar closes; otherwise the one
// before it (always closed). Nothing from an unclosed 5D bar is counted.
[bNow, cNow]   = request.security(syminfo.tickerid, tf5, readBand(0), lookahead=barmerge.lookahead_on)
[bPrev, cPrev] = request.security(syminfo.tickerid, tf5, readBand(1), lookahead=barmerge.lookahead_on)

bool useNow = not na(cNow) and cNow <= time_close
bool below5 = useNow ? bNow : bPrev
int  close5 = useNow ? cNow : cPrev

var int lastBand = na
if below5 and not na(close5)
    lastBand := na(lastBand) ? close5 : math.max(lastBand, close5)
bool bandOn = not na(lastBand) and time_close - lastBand <= bandDays * DAY

// band / turn: per closed 5D bar
bool newBar5 = not na(close5) and (na(close5[1]) or close5 != close5[1])
var bool outside = false
bool goesOut = false
bool backIn  = false
if newBar5
    if below5 and not outside
        goesOut := true
        outside := true
    else if not below5 and outside
        backIn := true
        outside := false
bool bandNew = not na(lastBand) and (na(lastBand[1]) or lastBand != lastBand[1])

// ───────────────────────── Display
C_BAND = #7986CB
C_TURN = #E0E0E0
C_OFF  = color.new(#787B86, 70)

plot(1, "Track (off)", C_OFF, 1, display=display.pane)
plot(bandOn ? 1 : na, "Band window", C_BAND, 5, plot.style_linebr, display=display.pane)
plotshape(bandNew ? 1 : na, "Outside the band (track)", shape.circle, location.absolute, color.white, size=size.tiny, display=display.pane)
plot(0.5, "Scale floor", color.new(color.black, 100), display=display.pane)
plot(1.5, "Scale ceiling", color.new(color.black, 100), display=display.pane)

plotshape(showMarks and goesOut, "band", shape.triangleup, location.belowbar, C_BAND, text="band", textcolor=C_BAND, size=size.tiny, force_overlay=true)
plotshape(showMarks and backIn, "turn", shape.triangleup, location.belowbar, C_TURN, text="turn", textcolor=C_TURN, size=size.tiny, force_overlay=true)

// For checking against the lab's numbers: Data Window and CSV export only
plot(bandOn ? 1 : 0, "Band window on", display=display.data_window)
plot(outside ? 1 : 0, "Outside the band now", display=display.data_window)

posOf(string s) =>
    s == "Top left" ? position.top_left : s == "Bottom right" ? position.bottom_right : s == "Bottom left" ? position.bottom_left : position.top_right

fmt(int t) =>
    str.format_time(t, "dd MMM yyyy", "UTC")

var table tb = table.new(posOf(tblPos), 2, 4, bgcolor=color.new(#131722, 10), border_width=0, force_overlay=true)
if showTable and barstate.islast
    bool isEth = str.contains(syminfo.ticker, "ETH")
    color on  = #9FA8DA
    color off = #787B86
    table.cell(tb, 0, 0, "ROC band  " + tf5, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 0, outside ? "OUTSIDE the band" : "inside the band", text_color=outside ? on : off, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 1, "Band window", text_color=bandOn ? on : off, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 1, bandOn ? "ON  until " + fmt(lastBand + bandDays * DAY) : na(lastBand) ? "off" : "off  (ended " + fmt(lastBand + bandDays * DAY) + ")", text_color=bandOn ? on : off, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 2, "Watch item, not a lens. Closed 5D bars only.", text_color=off, text_size=size.tiny, text_halign=text.align_left)
    table.merge_cells(tb, 0, 2, 1, 2)
    table.cell(tb, 0, 3, isEth ? "Tested on ETH." : "Tested on ETH only. On BTC it showed no effect.", text_color=isEth ? off : #EF9A9A, text_size=size.tiny, text_halign=text.align_left)
    table.merge_cells(tb, 0, 3, 1, 3)

// ───────────────────────── Alerts
alertcondition(goesOut, "Backdrop: band (ROC closed outside the band)", "{{ticker}}: a 5D bar closed with ROC outside the lower band.")
alertcondition(backIn, "Backdrop: turn (ROC back inside the band)", "{{ticker}}: the first 5D bar back inside the ROC band.")
alertcondition(bandNew and not goesOut, "Backdrop: still outside the band", "{{ticker}}: another 5D bar closed outside the ROC band. Band window extended.")
