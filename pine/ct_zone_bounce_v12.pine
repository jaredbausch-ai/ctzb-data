//@version=6
// CT ZONE BOUNCE v12
// ---------------------------------------------------------------------------
// v12 ADDS A LIVE ODDS ENGINE. Every number you read on a signal is now
// MEASURED BY THE SCRIPT, from the history of the chart it is sitting on,
// instead of being a constant I pasted in from a study.
//
// HOW IT WORKS. One pass, no lookahead. When a signal confirms, the script
// files it in a pending queue with its entry close. Each later bar updates
// that entry's running peak and its worst close before that peak. When the
// horizon elapses - 60 days by default, converted to bars for whatever
// timeframe you are on - the entry is scored and filed under every tag it
// belongs to. A signal is only ever scored with information that existed
// after it, so nothing here can see the future.
//
// WHY IT MATTERS. The old constants went stale the moment the market moved,
// and they only ever described ETH and BTC. Drop v12 on SOL, LINK or anything
// else and it works out that chart's own odds from scratch. Nothing to
// refresh, nothing hardcoded, no dependency on me regenerating a table.
//
// VERIFIED. The streaming engine was prototyped against the batch study on
// ETH 2D before being written in Pine:
//        bucket      streaming        batch study
//        A           n=36  72%  +33.4%     n=36  72%  +33.4%
//        B           n=67  70%  +38.5%     n=67  70%  +38.5%
//        C           n=25  64%  +37.9%     n=26  62%  +34.8%
//        D           n=13  69%  +62.2%     n=14  71%  +57.7%
// A and B match exactly. C and D differ by one signal because the engine is
// still holding the newest entry open, which is correct behaviour.
//
// WHAT IS STILL HARDCODED, because a single chart cannot measure it:
//   - the ETH 5D confirmation window (needs another chart's trough dates)
//   - the confluence risk finding (needs two charts at once)
//   - the cycle-position bands (pooled across four charts)
//   - the extension flags (pooled across five charts)
// Those four blocks carry their sample sizes and the date they were measured.
//
// READ THE n COLUMN. On a fresh chart with little history the engine may have
// only a handful of scored signals, and a 100% win rate on n=3 means nothing.
// Rows under the minimum are hidden from the table by default.
//
// The figures will not match the odds document exactly. That study pooled
// several charts and used Coinbase history; this measures the one chart you
// are on, with whatever history your TradingView plan serves. Both are right.
// ---------------------------------------------------------------------------
// v11 gave the bear side its own parameters after v10's trigger halved the
// ETH 2D diamond count. BULL after 8 bars at or above 60; BEAR after 12 bars
// at or below 40. The asymmetry is real: 8+ bar runs above 60 happened 27
// times in bull windows and never in a bear, while dips below 40 are common
// in both, so the bear trigger has to be slower.
// v10 promoted the prime dot and dropped the hollow-beats-filled claim.
// v9 removed the range expansion filter. v8 removed the WGMI block and star.
// v6 added the "?" provisional marker, which REPAINTS by design.
indicator("CT Zone Bounce v12", "CTZB", overlay=false, max_labels_count=500, max_lines_count=500)

gI = "Indicator"
rsiLen = input.int(14, "CT RSI length", group=gI, minval=2)
rsiSrc = input.source(close, "Source", group=gI)
sigLen = input.int(14, "Signal line", group=gI, minval=1)
stLen  = input.int(14, "Stoch RSI length", group=gI, minval=2)
smK    = input.int(3, "Stoch %K", group=gI, minval=1)
smD    = input.int(3, "Stoch %D", group=gI, minval=1)
pvL    = input.int(3, "Pivot left bars", group=gI, minval=1)
pvR    = input.int(3, "Pivot right bars", group=gI, minval=1)

gZ = "Zones"
zBear = input.float(40, "Bearish control ceiling", group=gZ)
zMid  = input.float(50, "Neutral line (diamond split)", group=gZ)
bSpl  = input.float(55, "A/B vs C split", group=gZ)
dSpl  = input.float(65, "C vs D split", group=gZ)

gC = "Regime"
oRsi  = "CT RSI bull control zone (BTC 2D)"
oWin  = "Bull windows below"
oDate = "Bull from one date on"
oBull = "Always BULL"
oBear = "Always BEAR"
regMode = input.string(oRsi, "Regime source", options=[oRsi,oWin,oDate,oBull,oBear], group=gC)
rzSym   = input.symbol("COINBASE:BTCUSD", "Regime driver", group=gC)
rzTF    = input.timeframe("2D", "Regime timeframe", group=gC)
rzBull  = input.float(60, "BULL control floor", group=gC)
rzBullN = input.int(8, "Bars at or above the floor to turn BULL", group=gC, minval=1)
rzBear  = input.float(40, "BEAR control ceiling", group=gC)
rzBearN = input.int(12, "Bars at or below the ceiling to turn BEAR", group=gC, minval=1)
rzStart = input.bool(false, "Start in BULL before the first trigger", group=gC)
bullSince = input.time(timestamp("2026-06-24T00:00"), "One date: bull starts", group=gC)
useW1 = input.bool(true, "Window 1", inline="w1", group=gC)
b1s = input.time(timestamp("2014-12-04T00:00"), "", inline="w1", group=gC)
b1e = input.time(timestamp("2017-12-17T00:00"), "to", inline="w1", group=gC)
useW2 = input.bool(true, "Window 2", inline="w2", group=gC)
b2s = input.time(timestamp("2018-12-17T00:00"), "", inline="w2", group=gC)
b2e = input.time(timestamp("2021-11-10T00:00"), "to", inline="w2", group=gC)
useW3 = input.bool(true, "Window 3", inline="w3", group=gC)
b3s = input.time(timestamp("2022-11-10T00:00"), "", inline="w3", group=gC)
b3e = input.time(timestamp("2025-10-06T00:00"), "to", inline="w3", group=gC)
useW4 = input.bool(true, "Window 4", inline="w4", group=gC)
b4s = input.time(timestamp("2026-06-24T00:00"), "", inline="w4", group=gC)
b4e = input.time(timestamp("2029-12-31T00:00"), "to", inline="w4", group=gC)

gD = "Display"
waitCl   = input.bool(true, "Print only after the confirm candle CLOSES", group=gD)
disOnly  = input.bool(false, "Show ONLY diamond signals", group=gD)
showOff  = input.bool(true, "Ghost out-of-window signals", group=gD)
dimAli   = input.bool(true, "Dim non-diamond signals", group=gD)
showConn = input.bool(false, "Line to prior trough", group=gD)
showStoch= input.bool(true, "Plot Stoch RSI", group=gD)

gY = "Cycle position"
showCyc = input.bool(true, "Show the cycle-day counter", group=gY)
cl1 = input.time(timestamp("2015-01-14T00:00"), "Cycle low 1", group=gY)
cl2 = input.time(timestamp("2018-12-15T00:00"), "Cycle low 2", group=gY)
cl3 = input.time(timestamp("2022-11-21T00:00"), "Cycle low 3", group=gY)
cl4 = input.time(timestamp("2026-06-24T00:00"), "Cycle low 4 (current)", group=gY)

gO = "Live odds engine"
showOdds = input.bool(true, "Show the measured odds table", group=gO)
oHorizon = input.int(60, "Horizon in days", group=gO, minval=5)
oMinN    = input.int(5, "Hide rows under this many signals", group=gO, minval=1)
oPos     = input.string("Bottom right", "Table position", options=["Bottom right","Bottom left","Top left","Middle right"], group=gO)

gP = "Provisional markers (repaint)"
showProv = input.bool(true, "Show '?' early-warning markers", group=gP)
// 1 bar held = 57-64% confirm.  2 bars held = 80-84% confirm.
provMin  = input.int(1, "Bars held before showing", group=gP, minval=1)

ct = ta.rsi(rsiSrc, rsiLen)
sg = ta.ema(ct, sigLen)
kL = ta.sma(ta.stoch(ct, ct, ct, stLen), smK)
dL = ta.sma(kL, smD)

inW(bool use, int a, int b) =>
    use and time >= a and time <= b

// The control-zone state machine. Evaluated on the driver chart, so it reads
// the same whatever timeframe you put this indicator on.
f_rz() =>
    float c = ta.rsi(close, rsiLen)
    var bool st = rzStart
    var int nUp = 0
    var int nDn = 0
    nUp := c >= rzBull ? nUp + 1 : 0
    nDn := c <= rzBear ? nDn + 1 : 0
    if nUp >= rzBullN
        st := true
        nDn := 0
    else if nDn >= rzBearN
        st := false
        nUp := 0
    st ? 1.0 : 0.0

rzRaw = request.security(rzSym, rzTF, f_rz(), lookahead=barmerge.lookahead_off)
rzOK = not na(rzRaw) and rzRaw > 0.5

regOK = inW(useW1,b1s,b1e) or inW(useW2,b2s,b2e) or inW(useW3,b3s,b3e) or inW(useW4,b4s,b4e)
if regMode == oRsi
    regOK := rzOK
else if regMode == oDate
    regOK := time >= bullSince
else if regMode == oBull
    regOK := true
else if regMode == oBear
    regOK := false


h100 = hline(100, "", color=color.new(color.gray, 85))
hBul = hline(60, "Bull control floor", color=color.new(color.teal, 55))
hMid = hline(50, "Neutral line", color=color.new(color.gray, 35), linestyle=hline.style_dashed)
hBer = hline(40, "Bear control ceiling", color=color.new(color.red, 55))
h0   = hline(0, "", color=color.new(color.gray, 85))
fill(hBul, h100, color=color.new(color.teal, 93), title="Bull control")
fill(hMid, hBul, color=color.new(color.teal, 97), title="Neutral bullish")
fill(hBer, hMid, color=color.new(color.red, 97), title="Neutral bearish")
fill(h0, hBer, color=color.new(color.red, 93), title="Bear control")

plot(ct, "CT RSI", color=color.new(#7E57C2, 0), linewidth=2)
plot(sg, "Signal", color=color.new(color.orange, 45))
plot(showStoch ? kL : na, "Stoch %K", color=color.new(color.blue, 60))
plot(showStoch ? dL : na, "Stoch %D", color=color.new(color.red, 70))

// ---- EXTENSION FLAGS (context only - nothing is filtered on them) ----
// Signals that went on to START a run of 3+ consecutive losers looked like
// this at entry, measured on 979 signals across five charts:
//                              starts a run    does not
//     stoch at the trough           56.5          27.6
//     price over the SMA50        +18.3%         +5.6%
//     prior 20 days               +14.7%         +2.7%
//     drawdown from the ATH       -22.5%        -44.3%
// Scored on four flags built from that:
//     0 flags  n=304   1% started a cluster   75% win
//     1 flag   n=254   2%                     75%
//     2 flags  n=185   8%                     68%
//     3 flags  n=165   6%                     67%
//     4 flags  n= 71  11%                     61%
// An elevenfold spread on the cluster rate, but clusters are rare, so four
// flags still means 89% of the time nothing happens. As a trade filter it is
// worth +4 for the loss of 40% of the winners, which is not worth it. It
// appears on the tooltip and nowhere else. Four of four means "extended,
// size smaller, take profit sooner", never "skip".
ma50p = ta.sma(close, 50)
runUp = close[20] != 0 ? close / close[20] * 100 - 100 : 0.0
var float athSeen = na
athSeen := na(athSeen) ? close : math.max(athSeen, close)
ddATH = athSeen != 0 ? close / athSeen * 100 - 100 : 0.0

pv  = ta.pivotlow(ct, pvL, pvR)
isP = not na(pv)
tK  = kL[pvR]
pvB = bar_index - pvR
bk  = isP ? (pv < zBear ? "A" : pv < bSpl ? "B" : pv < dSpl ? "C" : "D") : "-"

var float pCt = na
var float pK  = na
var int   pB  = na

barOK = barstate.isconfirmed or not waitCl
sigBar = isP and regOK
hasPrev = sigBar and not na(pCt)
dCt = hasPrev ? pv - pCt : na
dK  = hasPrev ? tK - pK : na
dis = hasPrev and ((dCt > 0 and dK < 0) or (dCt < 0 and dK > 0))
below = isP and pv < zMid
strong = dis and below
prime = isP and tK >= 20 and tK < 50


// ===========================================================================
// LIVE ODDS ENGINE  -  measures this chart's own history, one pass, no lookahead
// ===========================================================================
// Tag rows: 0 all, 1 A, 2 B, 3 C, 4 D, 5 any diamond, 6 filled, 7 hollow,
//           8 prime dot, 9 diamond+dot, 10 zone-exit B (left 60, dip held 50)
oBarsPerDay = timeframe.in_seconds() / 86400.0
oHold = math.max(1, math.round(oHorizon / math.max(oBarsPerDay, 0.0001)))

var array<int>    tagN = array.new_int(11, 0)
var array<int>    tagW = array.new_int(11, 0)
var matrix<float> upM  = matrix.new<float>(11, 500, na)
var matrix<float> rkM  = matrix.new<float>(11, 500, na)

var array<int>   qBar = array.new_int()
var array<float> qPx  = array.new_float()
var array<float> qBst = array.new_float()
var array<float> qMin = array.new_float()
var array<float> qRsk = array.new_float()
var array<int>   qBk  = array.new_int()
var array<int>   qDi  = array.new_int()
var array<int>   qPr  = array.new_int()
var array<int>   qZn  = array.new_int()

oRec(int t, float up, float rk, bool win) =>
    int c = array.get(tagN, t)
    array.set(tagN, t, c + 1)
    if win
        array.set(tagW, t, array.get(tagW, t) + 1)
    if c < 500
        matrix.set(upM, t, c, up)
        matrix.set(rkM, t, c, rk)

// track the current excursion out of the bull control zone
var float zMin = na
if ct >= rzBull
    zMin := na
else
    zMin := na(zMin) ? ct : math.min(zMin, ct)

// ---- 1. advance and score anything already pending (BEFORE filing new ones) ----
if array.size(qBar) > 0
    for ii = array.size(qBar) - 1 to 0
        float bst = array.get(qBst, ii)
        float mnc = math.min(array.get(qMin, ii), close)
        array.set(qMin, ii, mnc)
        if high > bst
            array.set(qBst, ii, high)
            array.set(qRsk, ii, mnc)
        if bar_index - array.get(qBar, ii) >= oHold
            float px = array.get(qPx, ii)
            float up = (array.get(qBst, ii) / px - 1) * 100
            float rk = (array.get(qRsk, ii) / px - 1) * 100
            bool  wn = close > px
            int   bq = array.get(qBk, ii)
            int   dq = array.get(qDi, ii)
            int   pq = array.get(qPr, ii)
            int   zq = array.get(qZn, ii)
            oRec(0, up, rk, wn)
            oRec(bq, up, rk, wn)
            if dq > 0
                oRec(5, up, rk, wn)
                oRec(dq == 1 ? 6 : 7, up, rk, wn)
            if pq > 0
                oRec(8, up, rk, wn)
                if dq > 0
                    oRec(9, up, rk, wn)
            if zq > 0
                oRec(10, up, rk, wn)
            array.remove(qBar, ii)
            array.remove(qPx, ii)
            array.remove(qBst, ii)
            array.remove(qMin, ii)
            array.remove(qRsk, ii)
            array.remove(qBk, ii)
            array.remove(qDi, ii)
            array.remove(qPr, ii)
            array.remove(qZn, ii)

// ---- 2. file a newly confirmed signal ----
if isP and regOK and barstate.isconfirmed
    int bkI = pv < zBear ? 1 : pv < bSpl ? 2 : pv < dSpl ? 3 : 4
    int diI = dis ? (strong ? 1 : 2) : 0
    int prI = prime ? 1 : 0
    float zm = zMin[pvR]
    bool zOK = bkI == 2 and ct[pvR] < rzBull and not na(zm) and zm >= zMid
    array.push(qBar, bar_index)
    array.push(qPx, close)
    array.push(qBst, close)
    array.push(qMin, close)
    array.push(qRsk, close)
    array.push(qBk, bkI)
    array.push(qDi, diI)
    array.push(qPr, prI)
    array.push(qZn, zOK ? 1 : 0)

// ---- 3. readers ----
oN(int t) =>
    array.get(tagN, t)

oWin(int t) =>
    int c = array.get(tagN, t)
    c > 0 ? 100.0 * array.get(tagW, t) / c : na

oUp(int t) =>
    int c = math.min(array.get(tagN, t), 500)
    float r = na
    if c > 0
        array<float> tmp = array.new_float()
        for i = 0 to c - 1
            array.push(tmp, matrix.get(upM, t, i))
        r := array.median(tmp)
    r

oRk(int t) =>
    int c = math.min(array.get(tagN, t), 500)
    float r = na
    if c > 0
        array<float> tmp = array.new_float()
        for i = 0 to c - 1
            array.push(tmp, matrix.get(rkM, t, i))
        r := array.median(tmp)
    r

oEdge(int t) =>
    float a = oWin(t)
    float z = oWin(0)
    na(a) or na(z) ? na : a - z

oName(int t) =>
    t == 0 ? "all troughs" : t == 1 ? "A  <40" : t == 2 ? "B  40-55" : t == 3 ? "C  55-65" : t == 4 ? "D  >65" : t == 5 ? "any diamond" : t == 6 ? "filled <50" : t == 7 ? "hollow >=50" : t == 8 ? "prime dot" : t == 9 ? "diamond + dot" : "B out of the zone"

// one tooltip line for a tag row
oLine(string lead, int t) =>
    string s = ""
    if oN(t) >= oMinN
        s := lead + "  n=" + str.tostring(oN(t)) + "  " + str.tostring(oWin(t), "#") + "%  up " + str.tostring(oUp(t), "+#.#") + "%  risk " + str.tostring(oRk(t), "#.#") + "%  edge " + str.tostring(oEdge(t), "+#") + "\n"
    else if oN(t) > 0
        s := lead + "  only n=" + str.tostring(oN(t)) + " so far, too few to score\n"
    s

bkName(string b) =>
    string r = "Dip inside bull control"
    r := b == "A" ? "Bounce off bear control" : b == "B" ? "Bounce off neutral" : b == "C" ? "Bounce off bull base" : r
    r

bkCol(string b) =>
    b == "A" ? #26A69A : b == "B" ? #42A5F5 : b == "C" ? #AB47BC : #FFA726

fmtE(float e) =>
    na(e) ? "n/a" : (e >= 0 ? "+" : "") + str.tostring(e, "#") + " pp"

pass = disOnly ? dis : true
draw = isP and (regOK or showOff) and pass and barOK

if draw
    string sym = regOK ? bk : str.lower(bk)
    if dis and regOK
        sym := (strong ? "◆" : "◇") + sym
    if prime and regOK
        sym := sym + "●"

    string t1 = "plain bounce\n"
    if dis
        t1 := strong ? "◆ filled diamond, trough below 50\n" : "◇ hollow diamond, trough above 50\n"
    string t2 = bk + " - " + bkName(bk) + "\n"
    string t3 = "CT trough " + str.tostring(pv, "#.#")
    string t4 = hasPrev ? "  (prev " + str.tostring(pCt, "#.#") + ")\n" : "\n"
    string t5 = "Stoch K   " + str.tostring(tK, "#.#") + "\n"
    int bkIx = pv < zBear ? 1 : pv < bSpl ? 2 : pv < dSpl ? 3 : 4
    float zmT = zMin[pvR]
    bool zOKT = bkIx == 2 and ct[pvR] < rzBull and not na(zmT) and zmT >= zMid
    string t7 = ""
    if prime
        t7 := "\n● PRIME DOT - stoch 20-50 at the trough\n"
    else if dis
        t7 := "\nno prime dot - stoch was outside 20-50 at the trough\n"
    string t8 = "\nMEASURED ON THIS CHART, " + str.tostring(oHorizon) + "-day horizon,\nas it stood when this signal printed:\n"
    t8 := t8 + oLine(oName(0), 0)
    t8 := t8 + oLine(oName(bkIx), bkIx)
    if dis
        t8 := t8 + oLine(oName(5), 5)
        t8 := t8 + oLine(oName(strong ? 6 : 7), strong ? 6 : 7)
    if prime
        t8 := t8 + oLine(oName(8), 8)
        if dis
            t8 := t8 + oLine(oName(9), 9)
    if zOKT
        t8 := t8 + "\nTHIS IS THE ZONE-EXIT SETUP - left the bull zone,\nthe dip held " + str.tostring(zMid, "#") + ", trough in the B band:\n"
        t8 := t8 + oLine(oName(10), 10)
    t8 := t8 + "\nCONFLUENCE, measured across charts (not on this one):\n"
    t8 := t8 + "  within 10 days of an ETH 5D trough: 85% vs 52%\n"
    t8 := t8 + "  2D and 3D both printing B halves the drawdown,\n  but does NOT reliably raise the win rate\n"
    int xf = 0
    xf := xf + (tK > 45 ? 1 : 0)
    xf := xf + (not na(ma50p) and close / ma50p * 100 - 100 > 12 ? 1 : 0)
    xf := xf + (ddATH > -20 ? 1 : 0)
    xf := xf + (runUp > 8 ? 1 : 0)
    string tX = "\nEXTENSION " + str.tostring(xf) + "/4"
    tX := tX + (xf >= 3 ? "  - stretched. 61-67% historically, and 4/4 starts a\nrun of 3+ losers 11% of the time vs 1% at zero flags.\nSize smaller, take profit sooner. Not a reason to skip.\n" : "  - not stretched. 75% historically.\n")
    string tA = regOK ? "" : "\n\nOutside your bull window"
    string tip = t1 + t2 + t3 + t4 + t5 + t7 + t8 + tX + tA

    int tr = (dimAli and not dis) ? 45 : 0
    color bg = color.new(bkCol(bk), tr)
    color tc = color.white
    if dis
        bg := strong ? color.new(#FFD54F, 0) : color.new(#FFD54F, 55)
        tc := strong ? color.black : color.white
    if not regOK
        bg := color.new(color.gray, 75)
        tc := color.new(color.silver, 20)
    label.new(pvB, pv, text=sym, style=label.style_label_up, color=bg,
       textcolor=tc, size=size.tiny, yloc=yloc.price, tooltip=tip)

    if showConn and hasPrev
        color lc = dis ? color.new(#FFD54F, 20) : color.new(color.gray, 80)
        line.new(pB, pCt, pvB, pv, xloc=xloc.bar_index, color=lc, width=dis ? 2 : 1, style=line.style_dotted)

diaRow = strong and regOK and pass and barOK
plotshape(diaRow, "Diamond row", shape.diamond, location.bottom, color=color.new(#FFD54F, 0), size=size.tiny)
primeRow = isP and prime and dis and regOK and barOK
plotshape(primeRow, "Prime dot row", shape.circle, location.bottom, color=color.new(#26A69A, 0), size=size.tiny)
bgcolor(regOK ? color.new(color.teal, 96) : na, title="Bull window")

if sigBar and barOK
    pCt := pv
    pK  := tK
    pB  := pvB

// ---- PROVISIONAL: a low that has held, but not yet for pvR bars ----
// Left side is already known; we just need the right side to have held so far.
provAt(int r) =>
    bool ok = r >= provMin and r < pvR and not na(ct[r + pvL])
    float v = ok ? ct[r] : na
    if ok
        for i = 1 to pvL
            if ct[r + i] <= v
                ok := false
        for i = 0 to r - 1
            if ct[i] < v
                ok := false
    ok

// take the OLDEST qualifying offset, i.e. the one closest to confirming
pr = 0
for r = pvR - 1 to provMin
    if pr == 0 and provAt(r)
        pr := r

var label pLbl = na
label.delete(pLbl)

if showProv and pr > 0 and regOK and not isP and barstate.islast
    float ppv = ct[pr]
    float ptK = kL[pr]
    string pbk = ppv < zBear ? "A" : ppv < bSpl ? "B" : ppv < dSpl ? "C" : "D"
    bool pHas = not na(pCt)
    float pdC = pHas ? ppv - pCt : na
    float pdK = pHas ? ptK - pK : na
    bool pdis = pHas and ((pdC > 0 and pdK < 0) or (pdC < 0 and pdK > 0))
    bool pstr = pdis and ppv < zMid
    string psym = "?" + (pdis ? (pstr ? "◆" : "◇") : "") + pbk + (ptK >= 20 and ptK < 50 ? "●" : "")
    int need = pvR - pr
    string pt = "PROVISIONAL - not confirmed\n"
    pt := pt + "needs " + str.tostring(need) + " more bar(s) above " + str.tostring(ppv, "#.#") + "\n"
    string wd = pdis ? (pstr ? "gold diamond" : "hollow diamond") : "plain " + pbk
    pt := pt + "\nwould print as: " + wd + "\n"
    pt := pt + "CT " + str.tostring(ppv, "#.#") + "  Stoch K " + str.tostring(ptK, "#.#") + "\n"
    string od = need == 1 ? "80-84% of these confirm" : "57-64% of these confirm"
    pt := pt + "\n" + od + " (ETH history).  THIS CAN VANISH.\n"
    int pbi = ppv < zBear ? 1 : ppv < bSpl ? 2 : ppv < dSpl ? 3 : 4
    float pzm = zMin[pr]
    bool pzOK = pbi == 2 and ct[pr] < rzBull and not na(pzm) and pzm >= zMid
    bool pprime = ptK >= 20 and ptK < 50
    pt := pt + "\nIF IT CONFIRMS, this is what that tag has paid\non this chart over " + str.tostring(oHorizon) + " days:\n"
    pt := pt + oLine(oName(0), 0)
    pt := pt + oLine(oName(pbi), pbi)
    if pdis
        pt := pt + oLine(oName(5), 5)
        pt := pt + oLine(oName(pstr ? 6 : 7), pstr ? 6 : 7)
    if pprime
        pt := pt + oLine(oName(8), 8)
        if pdis
            pt := pt + oLine(oName(9), 9)
    if pzOK
        pt := pt + "\nZONE-EXIT SETUP - left the bull zone, dip held " + str.tostring(zMid, "#") + ":\n"
        pt := pt + oLine(oName(10), 10)
    pt := pt + "\nFront-running does not pay: buying 1 bar early\nmeans 31% of them never confirm, and those run\n4x the drawdown. Waiting cost nothing historically."
    color pbg = color.new(pdis ? #FFD54F : bkCol(pbk), 70)
    pLbl := label.new(bar_index - pr, ppv, text=psym, style=label.style_label_up,
       color=pbg, textcolor=color.new(color.white, 15), size=size.tiny,
       yloc=yloc.price, tooltip=pt)


// ---- the measured-odds table ----
oTblPos() =>
    oPos == "Bottom left" ? position.bottom_left : oPos == "Top left" ? position.top_left : oPos == "Middle right" ? position.middle_right : position.bottom_right

var table oT = table.new(oTblPos(), 6, 13, border_width=1, frame_width=1, frame_color=color.new(color.gray, 55), bgcolor=color.new(color.black, 25))

oCell(int r, int c, string s, color tx) =>
    table.cell(oT, c, r, s, text_color=tx, text_size=size.tiny)

if barstate.islast and showOdds
    table.clear(oT, 0, 0, 5, 12)
    oCell(0, 0, "MEASURED ON THIS CHART", color.white)
    oCell(0, 1, "n", color.white)
    oCell(0, 2, "WIN", color.white)
    oCell(0, 3, "UPSIDE", color.white)
    oCell(0, 4, "RISK", color.white)
    oCell(0, 5, "EDGE", color.white)
    int rr = 1
    for t = 0 to 10
        if oN(t) >= oMinN and rr < 12
            float ed = oEdge(t)
            color tc = t == 0 ? color.new(color.silver, 15) : na(ed) ? color.silver : ed >= 10 ? color.new(#26A69A, 0) : ed <= -5 ? color.new(color.red, 20) : color.silver
            oCell(rr, 0, oName(t), tc)
            oCell(rr, 1, str.tostring(oN(t)), color.new(color.silver, 40))
            oCell(rr, 2, str.tostring(oWin(t), "#") + "%", tc)
            oCell(rr, 3, str.tostring(oUp(t), "+#.#") + "%", tc)
            oCell(rr, 4, str.tostring(oRk(t), "#.#") + "%", color.new(color.silver, 40))
            oCell(rr, 5, t == 0 ? "base" : str.tostring(ed, "+#"), tc)
            rr := rr + 1
    oCell(12, 0, str.tostring(oHorizon) + "d horizon  -  " + str.tostring(array.size(qBar)) + " still open, not yet scored", color.new(color.silver, 45))

alertcondition(isP and regOK and dis, "Any diamond", "CTZB diamond")
alertcondition(isP and regOK and strong, "Filled diamond (trough below 50)", "CTZB filled diamond")
alertcondition(isP and regOK and dis and not strong, "Hollow diamond (trough above 50)", "CTZB hollow diamond")
alertcondition(isP and regOK and dis and prime, "Diamond + prime dot", "CTZB diamond with stoch 20-50")
alertcondition(isP and regOK, "Any bounce", "CTZB signal")
alertcondition(isP and regOK and prime, "Prime stoch (K 20-50)", "CTZB prime")
alertcondition(isP and regOK and dis and prime, "Diamond + PRIME DOT", "CTZB diamond with the prime dot - strongest out-of-sample tag")
alertcondition(isP and regOK and bk == "A", "A signal", "CTZB A")
alertcondition(isP and regOK and bk == "B", "B signal", "CTZB B")
alertcondition(isP and regOK and bk == "C", "C signal", "CTZB C")
alertcondition(isP and regOK and bk == "D", "D signal", "CTZB D")
provFire = showProv and pr > 0 and regOK and not isP
alertcondition(provFire, "Provisional forming", "CTZB: provisional low forming, not yet confirmed")

// ---- cycle position ----
// Diamonds pooled across ETH/BTC 1D+2D by where in the cycle they fired:
//   day   0-200  n=40  72% up, +28.6% upside
//   day 200-400  n=35  66% up, +22.8% upside
//   day 400-600  n=44  73% up, +26.2% upside
//   day 600-900  n=63  83% up, +56.9% upside
//   day 900+     n=39  79% up, +40.8% upside
lastLow = time >= cl4 ? cl4 : time >= cl3 ? cl3 : time >= cl2 ? cl2 : cl1
cycDay = int(math.floor((time - lastLow) / 86400000.0))
cycBand = cycDay < 200 ? "0-200  weakest" : cycDay < 400 ? "200-400" : cycDay < 600 ? "400-600" : cycDay < 900 ? "600-900  best" : "900+"
cycUp = cycDay < 200 ? "+28.6%" : cycDay < 400 ? "+22.8%" : cycDay < 600 ? "+26.2%" : cycDay < 900 ? "+56.9%" : "+40.8%"

var table cycT = table.new(position.top_right, 1, 2, bgcolor=color.new(color.black, 30))
if barstate.islast and showCyc
    table.cell(cycT, 0, 0, "cycle day " + str.tostring(cycDay) + "   " + cycBand, text_color=cycDay >= 600 and cycDay < 900 ? color.lime : color.silver, text_size=size.tiny)
    table.cell(cycT, 0, 1, "diamonds here: " + cycUp + " upside historically", text_color=color.new(color.silver, 25), text_size=size.tiny)
