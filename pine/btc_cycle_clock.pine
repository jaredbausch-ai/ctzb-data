med90Low(int dd) =>
    int b = dd < 0 ? 0 : int(math.min(18, math.floor(dd / 60)))
    float m = na
    if b == 0
        m := 41.2
    else if b == 1
        m := 23.6
    else if b == 2
        m := 7.2
    else if b == 3
        m := -4.6
    else if b == 4
        m := 20.2
    else if b == 5
        m := 18.4
    else if b == 6
        m := 17.1
    else if b == 7
        m := 40.9
    else if b == 8
        m := 7.2
    else if b == 9
        m := 10.0
    else if b == 10
        m := 47.4
    else if b == 11
        m := 58.1
    else if b == 12
        m := 49.2
    else if b == 13
        m := 9.6
    else if b == 14
        m := 30.0
    else if b == 15
        m := 41.4
    else if b == 16
        m := 18.3
    else if b == 17
        m := -23.6
    else if b == 18
        m := -21.1
    m

med90Ath(int dd) =>
    int b = dd < 0 ? 0 : int(math.min(24, math.floor(dd / 60)))
    float m = na
    if b == 0
        m := -23.3
    else if b == 1
        m := -21.0
    else if b == 2
        m := -14.7
    else if b == 3
        m := -12.7
    else if b == 4
        m := -17.6
    else if b == 5
        m := -12.9
    else if b == 6
        m := 40.9
    else if b == 7
        m := 27.9
    else if b == 8
        m := 16.1
    else if b == 9
        m := -5.1
    else if b == 10
        m := 15.5
    else if b == 11
        m := 32.1
    else if b == 12
        m := -0.7
    else if b == 13
        m := 31.9
    else if b == 14
        m := 26.1
    else if b == 15
        m := 0.3
    else if b == 16
        m := 27.4
    else if b == 17
        m := 59.4
    else if b == 18
        m := 46.3
    else if b == 19
        m := 1.8
    else if b == 20
        m := 29.6
    else if b == 21
        m := 36.5
    else if b == 22
        m := 18.6
    else if b == 23
        m := -17.2
    else if b == 24
        m := 2.2
    m

rate(int dd, string h, bool lowAnchor) =>
    lowAnchor ? rateLow(dd, h) : rateAth(dd, h)

nowRate = rate(dsa, hz, useLow)
fwdRate = rate(dsa + leadDays, hz, useLow)
othRate = useLow ? rateAth(dAth, hz) : rateLow(dLow, hz)
nowMed  = useLow ? med90Low(dsa) : med90Ath(dsa)

// ---- plots ----
plot(nowRate, "Hit rate at this cycle position", color=nowRate >= baseRate ? color.new(#2ECC71, 0) : color.new(#E74C3C, 0), linewidth=3)
plot(showFwd ? fwdRate : na, "Forward - same record, future calendar dates", color=color.new(color.gray, 40), linewidth=2, offset=leadBars)
plot(showOther ? othRate : na, "The other anchor", color=color.new(color.aqua, 70), linewidth=1)

hline(baseRate, "always-up baseline", color=color.new(color.yellow, 25), linewidth=2, linestyle=hline.style_dashed)
hline(100, "", color=color.new(color.gray, 85))
hline(50, "coin flip", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(0, "", color=color.new(color.gray, 85))

bgcolor(na(nowRate) ? na : (nowRate >= baseRate ? color.new(#2ECC71, 92) : color.new(#E74C3C, 90)))

alertcondition(ta.crossover(nowRate, baseRate), "Clock turns favourable", "CYCLE CLOCK: this position historically beat the baseline")
alertcondition(ta.crossunder(nowRate, baseRate), "Clock turns unfavourable", "CYCLE CLOCK: this position historically lagged the baseline")

// ---- readout ----
var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 70))
cell(int c, int r, string s, color tc, color bg) =>
    table.cell(t, c, r, s, text_color=tc, bgcolor=bg, text_size=size.small, text_halign=c == 0 ? text.align_left : text.align_right)

if barstate.islast
    int b0 = int(math.floor(dsa / 60))
    color hc = na(nowRate) ? color.gray : (nowRate >= baseRate ? #2ECC71 : #E74C3C)
    cell(0, 0, useLow ? "DAYS SINCE THE LOW" : "DAYS SINCE THE ATH", color.white, color.new(color.black, 40))
    cell(1, 0, str.tostring(dsa), color.white, color.new(color.black, 40))
    cell(0, 1, "bucket", color.silver, color.new(color.black, 65))
    cell(1, 1, str.tostring(b0 * 60) + "-" + str.tostring(b0 * 60 + 60) + "d", color.silver, color.new(color.black, 65))
    cell(0, 2, "up at " + hz + ", historically", color.white, color.new(color.black, 55))
    cell(1, 2, na(nowRate) ? "-" : str.tostring(nowRate, "#") + "%", hc, color.new(color.black, 55))
    cell(0, 3, "vs baseline " + str.tostring(baseRate, "#") + "%", color.silver, color.new(color.black, 65))
    cell(1, 3, na(nowRate) ? "-" : (nowRate - baseRate >= 0 ? "+" : "") + str.tostring(nowRate - baseRate, "#") + " pp", hc, color.new(color.black, 65))
    cell(0, 4, "median 90d from here", color.silver, color.new(color.black, 55))
    cell(1, 4, na(nowMed) ? "-" : (nowMed >= 0 ? "+" : "") + str.tostring(nowMed, "#.#") + "%", color.silver, color.new(color.black, 55))
    cell(0, 5, "in " + str.tostring(leadDays) + " days", color.silver, color.new(color.black, 65))
    cell(1, 5, na(fwdRate) ? "-" : str.tostring(fwdRate, "#") + "%", na(fwdRate) ? color.gray : (fwdRate >= baseRate ? #2ECC71 : #E74C3C), color.new(color.black, 65))
    cell(0, 6, useLow ? "ATH clock says" : "low clock says", color.new(color.aqua, 20), color.new(color.black, 55))
    cell(1, 6, na(othRate) ? "-" : str.tostring(othRate, "#") + "%", color.new(color.aqua, 20), color.new(color.black, 55))
    cell(0, 7, "3 cycles - shape real, precision fake", color.new(color.orange, 0), color.new(color.black, 55))
    cell(1, 7, "", color.silver, color.new(color.black, 55))
