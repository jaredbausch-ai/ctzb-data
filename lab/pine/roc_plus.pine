//@version=6
// ROC+ — Rate of Change, improved. Statistics lab (stats-lab branch).
// v1 25 Nov 2026. v2 25 Nov 2026: divergence compares against the deepest ROC low in range
// (v1 missed ETH 5D 6 Apr 2025), and the lower-band WATCH WINDOW from lab/rocband10.py.
// The watch window is a watch item, not a lens: tested on ETH only (BTC showed no effect),
// fails the sample rule (12 signals before 2022, 5 break episodes). Entry quality only.
indicator(title="Rate of Change+", shorttitle="ROC+", format=format.price, precision=2, max_bars_back=500, max_lines_count=200)

// ───────────────────────── Inputs
G_CALC = "Calculation"
length     = input.int(9, "Length", minval=1, group=G_CALC)
source     = input.source(close, "Source", group=G_CALC)
mode       = input.string("Percent", "Mode", options=["Percent", "Log %", "Volatility-normalized"], group=G_CALC,
             tooltip="Percent: the classic ROC.\nLog %: symmetric, so +X and -X are the same size of move.\nVolatility-normalized: the move divided by what a normal move of that length has been lately (in sigma), so readings compare across quiet and violent markets.")
volLen     = input.int(100, "Normalization lookback", minval=10, group=G_CALC, tooltip="Bars of 1-bar log returns used to size a normal move. Volatility-normalized mode only.")
smoothType = input.string("None", "Smoothing", options=["None", "EMA", "SMA", "WMA", "HMA"], group=G_CALC)
smoothLen  = input.int(3, "Smoothing length", minval=2, group=G_CALC)

G_SIG = "Signal line"
showSig  = input.bool(true, "Show signal line", group=G_SIG)
sigLen   = input.int(9, "Signal length", minval=1, group=G_SIG)
showHist = input.bool(true, "Show histogram (ROC minus signal)", group=G_SIG)

G_BAND = "Extremes"
bandType = input.string("Percentile", "Bands", options=["Percentile", "Fixed", "None"], group=G_BAND,
           tooltip="Percentile: the ROC's own recent extremes, so the bands adapt as the market's range changes.\nFixed: your own levels, in the units of the Mode (% or sigma).")
pctLen   = input.int(250, "Percentile lookback", minval=20, group=G_BAND)
pctHi    = input.float(90, "Upper percentile", minval=50, maxval=100, group=G_BAND)
pctLo    = input.float(10, "Lower percentile", minval=0, maxval=50, group=G_BAND)
fixHi    = input.float(10, "Fixed upper", group=G_BAND)
fixLo    = input.float(-10, "Fixed lower", group=G_BAND)

G_DIV = "Divergence"
showDiv   = input.bool(true, "Show regular divergences", group=G_DIV)
divMode   = input.string("Deepest low in range", "Compare against", options=["Deepest low in range", "Previous pivot"], group=G_DIV,
            tooltip="Deepest low in range: a new ROC pivot low is compared with the lowest ROC reading between the min and max bars back (the highest, for bearish). This catches a divergence whose earlier low sits close to the new one.\nPrevious pivot: the classic TradingView method, only the last pivot. It missed ETH 5D 6 Apr 2025.")
pivL      = input.int(3, "Pivot bars left", minval=1, group=G_DIV)
pivR      = input.int(5, "Pivot bars right", minval=1, group=G_DIV, tooltip="A pivot is only known this many bars after it prints, so the label appears late by this many bars.")
rangeMin  = input.int(5, "Min bars back", minval=1, group=G_DIV)
rangeMax  = input.int(60, "Max bars back", minval=2, maxval=400, group=G_DIV)
sideOnly  = input.bool(true, "Bullish only below zero, bearish only above", group=G_DIV)

G_WATCH = "Watch window (lower-band break)"
showWatch = input.bool(true, "Shade the 60 days after a lower-band break", group=G_WATCH,
            tooltip="Fixed to the tested definition, whatever the display settings above: Percent ROC, length 9, no smoothing, 10th percentile of the last 250 bars, on the timeframe below, counted only once that bar has closed. Watch item, not a lens: tested on ETH only (BTC showed no effect).")
watchTF   = input.timeframe("5D", "Timeframe of the read", group=G_WATCH)
watchDays = input.int(60, "Window, days after the break bar closes", minval=1, group=G_WATCH)
showTable = input.bool(true, "Show watch status table", group=G_WATCH)

// ───────────────────────── Core
pctRoc = 100 * (source - source[length]) / source[length]
logMove = math.log(source / source[length])
logRoc = 100 * logMove
r1 = math.log(source / source[1])
normalMove = ta.stdev(r1, volLen) * math.sqrt(length)
zRoc = normalMove > 0 ? logMove / normalMove : na

raw = mode == "Percent" ? pctRoc : mode == "Log %" ? logRoc : zRoc

sEma = ta.ema(raw, smoothLen)
sSma = ta.sma(raw, smoothLen)
sWma = ta.wma(raw, smoothLen)
sHma = ta.hma(raw, smoothLen)
roc = switch smoothType
    "EMA" => sEma
    "SMA" => sSma
    "WMA" => sWma
    "HMA" => sHma
    => raw

sig  = ta.ema(roc, sigLen)
hist = roc - sig

// ───────────────────────── Bands
upPct = ta.percentile_nearest_rank(roc, pctLen, pctHi)
loPct = ta.percentile_nearest_rank(roc, pctLen, pctLo)
upper = bandType == "Percentile" ? upPct : bandType == "Fixed" ? fixHi : na
lower = bandType == "Percentile" ? loPct : bandType == "Fixed" ? fixLo : na

// ───────────────────────── Divergence
plFound = not na(ta.pivotlow(roc, pivL, pivR))
phFound = not na(ta.pivothigh(roc, pivL, pivR))
pOsc  = roc[pivR]
pLow  = low[pivR]
pHigh = high[pivR]

// Previous-pivot method (classic)
prevPLosc  = ta.valuewhen(plFound, pOsc, 1)
prevPLlow  = ta.valuewhen(plFound, pLow, 1)
prevPLbar  = ta.valuewhen(plFound, bar_index - pivR, 1)
prevPHosc  = ta.valuewhen(phFound, pOsc, 1)
prevPHhigh = ta.valuewhen(phFound, pHigh, 1)
prevPHbar  = ta.valuewhen(phFound, bar_index - pivR, 1)

// Deepest-in-range method: scan rangeMin..rangeMax bars before the pivot
float dlOsc = na
float dlLow = na
int   dlBar = na
float dhOsc = na
float dhHigh = na
int   dhBar = na
if plFound and divMode == "Deepest low in range"
    for k = pivR + rangeMin to pivR + rangeMax
        v = roc[k]
        if not na(v) and (na(dlOsc) or v < dlOsc)
            dlOsc := v
            dlLow := low[k]
            dlBar := bar_index - k
if phFound and divMode == "Deepest low in range"
    for k = pivR + rangeMin to pivR + rangeMax
        v = roc[k]
        if not na(v) and (na(dhOsc) or v > dhOsc)
            dhOsc := v
            dhHigh := high[k]
            dhBar := bar_index - k

bool  bullBase = false
bool  bearBase = false
float bRefOsc = na
int   bRefBar = na
float sRefOsc = na
int   sRefBar = na
if divMode == "Deepest low in range"
    bullBase := plFound and not na(dlOsc) and pOsc > dlOsc and pLow < dlLow
    bearBase := phFound and not na(dhOsc) and pOsc < dhOsc and pHigh > dhHigh
    bRefOsc := dlOsc
    bRefBar := dlBar
    sRefOsc := dhOsc
    sRefBar := dhBar
else
    gapL = bar_index - pivR - prevPLbar
    gapH = bar_index - pivR - prevPHbar
    bullBase := plFound and not na(prevPLbar) and gapL >= rangeMin and gapL <= rangeMax and pLow < prevPLlow and pOsc > prevPLosc
    bearBase := phFound and not na(prevPHbar) and gapH >= rangeMin and gapH <= rangeMax and pHigh > prevPHhigh and pOsc < prevPHosc
    bRefOsc := prevPLosc
    bRefBar := prevPLbar
    sRefOsc := prevPHosc
    sRefBar := prevPHbar

bullCond = showDiv and bullBase and (not sideOnly or pOsc < 0)
bearCond = showDiv and bearBase and (not sideOnly or pOsc > 0)

// ───────────────────────── Watch window (tested definition, fixed)
watchRead() =>
    r = 100 * (close - close[9]) / close[9]
    lb = ta.percentile_nearest_rank(r, 250, 10)
    // [1] with lookahead_on below = the last CLOSED bar of the watch timeframe, no repainting
    [r[1] < lb[1], time_close[1]]
[wBelow, wClose] = request.security(syminfo.tickerid, watchTF, watchRead(), lookahead=barmerge.lookahead_on)
var int lastBreak = na
if wBelow and not na(wClose)
    lastBreak := wClose
windowEnd = na(lastBreak) ? na : lastBreak + watchDays * 86400000
inWindow  = not na(lastBreak) and time >= lastBreak and time <= windowEnd

// ───────────────────────── Colours
C_UP   = #26A69A
C_DN   = #EF5350
C_SIG  = #FF9800
C_BAND = #787B86
C_WAT  = #5C6BC0

rising  = roc > roc[1]
lineCol = roc >= 0 ? (rising ? C_UP : color.new(C_UP, 45)) : (rising ? color.new(C_DN, 45) : C_DN)
histCol = hist >= 0 ? (hist > hist[1] ? color.new(C_UP, 40) : color.new(C_UP, 75)) : (hist < hist[1] ? color.new(C_DN, 40) : color.new(C_DN, 75))

// ───────────────────────── Plots
bgcolor(showWatch and inWindow ? color.new(C_WAT, 85) : na, title="Watch window")
plot(showHist ? hist : na, "Histogram", histCol, style=plot.style_columns)
hline(0, "Zero line", C_BAND)
pUp  = plot(upper, "Upper band", color.new(C_BAND, 40), style=plot.style_linebr)
pLo  = plot(lower, "Lower band", color.new(C_BAND, 40), style=plot.style_linebr)
pRoc = plot(roc, "ROC", lineCol, 2)
plot(showSig ? sig : na, "Signal", C_SIG, 1)

fill(pRoc, pUp, color = not na(upper) and roc > upper ? color.new(C_UP, 75) : na, title="Above upper band")
fill(pRoc, pLo, color = not na(lower) and roc < lower ? color.new(C_DN, 75) : na, title="Below lower band")

if bullCond and not na(bRefBar)
    line.new(bRefBar, bRefOsc, bar_index - pivR, pOsc, color=C_UP, width=2)
if bearCond and not na(sRefBar)
    line.new(sRefBar, sRefOsc, bar_index - pivR, pOsc, color=C_DN, width=2)
plotshape(bullCond ? pOsc : na, "Bullish divergence", shape.labelup, location.absolute, C_UP, offset=-pivR, text="Bull", textcolor=color.white, size=size.tiny)
plotshape(bearCond ? pOsc : na, "Bearish divergence", shape.labeldown, location.absolute, C_DN, offset=-pivR, text="Bear", textcolor=color.white, size=size.tiny)

// ───────────────────────── Watch status table
var table wt = table.new(position.top_right, 1, 3, bgcolor=color.new(#131722, 10), border_width=0)
if showWatch and showTable and barstate.islast
    hdr = "Watch: " + watchTF + " lower-band break"
    st  = na(lastBreak) ? "No break on record" : inWindow ? "OPEN until " + str.format_time(windowEnd, "dd MMM yyyy", "UTC") : "Closed " + str.format_time(windowEnd, "dd MMM yyyy", "UTC")
    lb  = na(lastBreak) ? "" : "Last break bar closed " + str.format_time(lastBreak, "dd MMM yyyy", "UTC")
    table.cell(wt, 0, 0, hdr, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(wt, 0, 1, st, text_color=inWindow ? #9FA8DA : #B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(wt, 0, 2, lb + (lb == "" ? "" : "  ·  ") + "Watch item, ETH only, not a lens", text_color=#787B86, text_size=size.tiny, text_halign=text.align_left)

// ───────────────────────── Alerts
crossUp = ta.crossover(roc, upper)
crossLo = ta.crossunder(roc, lower)
newBreak = not na(lastBreak) and (na(lastBreak[1]) or lastBreak != lastBreak[1])
alertcondition(ta.crossover(roc, 0),    "ROC+ crossed above zero",   "ROC+ crossed above zero on {{ticker}} {{interval}}")
alertcondition(ta.crossunder(roc, 0),   "ROC+ crossed below zero",   "ROC+ crossed below zero on {{ticker}} {{interval}}")
alertcondition(ta.crossover(roc, sig),  "ROC+ crossed above signal", "ROC+ crossed above its signal on {{ticker}} {{interval}}")
alertcondition(ta.crossunder(roc, sig), "ROC+ crossed below signal", "ROC+ crossed below its signal on {{ticker}} {{interval}}")
alertcondition(crossUp, "ROC+ entered upper band", "ROC+ entered its upper band on {{ticker}} {{interval}}")
alertcondition(crossLo, "ROC+ entered lower band", "ROC+ entered its lower band on {{ticker}} {{interval}}")
alertcondition(bullCond, "ROC+ bullish divergence", "ROC+ bullish divergence on {{ticker}} {{interval}}")
alertcondition(bearCond, "ROC+ bearish divergence", "ROC+ bearish divergence on {{ticker}} {{interval}}")
alertcondition(newBreak, "ROC+ watch window opened", "{{ticker}}: a closed " + "watch-timeframe bar broke the ROC+ lower band; 60-day watch window open")
