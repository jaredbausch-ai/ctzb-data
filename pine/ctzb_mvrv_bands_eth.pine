//@version=6
// CTZB MVRV Bands - ETH
// Full-history MVRV percentiles for ETH (Coin Metrics, n = 4,110, 2015-08-08..2026-11-07).
// A band at multiplier m is drawn at realised price * m.

indicator("CTZB MVRV Bands ETH", "MVRV ETH", overlay = true, max_labels_count = 20)

// ---------------- realised price ----------------
bool  useLive = input.bool(false, "Use live on-chain feed", group = "Data",
     tooltip = "Off = use the fixed realised price below. Turn on only after setting both symbols; if they do not resolve the bands will be wrong.")
float manRP   = input.float(2208.78, "Realised price", minval = 0.0, step = 0.01, group = "Data",
     tooltip = "ETH realised price on 2026-11-07. Static until you switch on the live feed.")
string rcSym  = input.symbol("", "Realised cap symbol", group = "Data")
string spSym  = input.symbol("", "Circulating supply symbol", group = "Data")

float realised = manRP
if useLive and rcSym != "" and spSym != ""
    float rc = request.security(rcSym, "D", close, ignore_invalid_symbol = true)
    float sp = request.security(spSym, "D", close, ignore_invalid_symbol = true)
    if not na(rc) and not na(sp) and sp > 0
        realised := rc / sp

float mvrv = realised > 0 ? close / realised : na

// ---------------- levels ----------------
string basis = input.string("Full history", "Percentile basis", options = ["Full history", "2019+"], group = "Levels")
float m05 = basis == "Full history" ? 0.624 : 0.64
float m10 = basis == "Full history" ? 0.74 : 0.739
float m25 = basis == "Full history" ? 0.967 : 0.931
float m50 = basis == "Full history" ? 1.207 : 1.13
float m75 = basis == "Full history" ? 1.549 : 1.35
float m90 = basis == "Full history" ? 2.026 : 1.657

float p05 = realised * m05
float p10 = realised * m10
float p25 = realised * m25
float p50 = realised * m50
float p75 = realised * m75
float p90 = realised * m90

// ---------------- display ----------------
bool  showZones = input.bool(true,  "Shade zones", group = "Display")
int   opa       = input.int(88, "Shading strength", minval = 70, maxval = 97, group = "Display",
     tooltip = "Lower = stronger colour.")
bool  showLbl   = input.bool(true,  "Price labels on the right", group = "Display")
int   lw        = input.int(2, "Line width", minval = 1, maxval = 4, group = "Display")

color cDeep = #1b6b52
color cLow  = #2f9e78
color cMid  = #8a8f98
color pHigh = #e07a3f
color cHot  = #c2410c

a05 = plot(p05, "5th pct",  color.new(cDeep, 10), lw)
a10 = plot(p10, "10th pct", color.new(cLow,  10), lw)
a25 = plot(p25, "25th pct", color.new(cLow,  25), lw)
a50 = plot(p50, "Median",   color.new(cMid,   0), lw + 1)
a75 = plot(p75, "75th pct", color.new(pHigh, 25), lw)
a90 = plot(p90, "90th pct", color.new(cHot,  10), lw)

fill(a05, a10, showZones ? color.new(cDeep,  opa - 4) : na, "Below 10th")
fill(a10, a25, showZones ? color.new(cLow,   opa)     : na, "10th to 25th")
fill(a25, a50, showZones ? color.new(cMid,   opa + 4) : na, "25th to median")
fill(a50, a75, showZones ? color.new(pHigh,  opa + 4) : na, "Median to 75th")
fill(a75, a90, showZones ? color.new(cHot,   opa)     : na, "75th to 90th")

// ---------------- right-edge labels ----------------
mkLabel(float price, string txt, color col) =>
    label.new(bar_index + 12, price, txt, xloc.bar_index, yloc.price,
         color.new(col, 85), label.style_label_left, col, size.small)

var label L05 = na
var label L10 = na
var label L25 = na
var label L50 = na
var label L75 = na
var label L90 = na
var label LMV = na
if showLbl and barstate.islast
    label.delete(L05), label.delete(L10), label.delete(L25)
    label.delete(L50), label.delete(L75), label.delete(L90), label.delete(LMV)
    L90 := mkLabel(p90, "90th  " + str.tostring(p90, format.mintick), cHot)
    L75 := mkLabel(p75, "75th  " + str.tostring(p75, format.mintick), pHigh)
    L50 := mkLabel(p50, "median  " + str.tostring(p50, format.mintick), cMid)
    L25 := mkLabel(p25, "25th  " + str.tostring(p25, format.mintick), cLow)
    L10 := mkLabel(p10, "10th  " + str.tostring(p10, format.mintick), cLow)
    L05 := mkLabel(p05, "5th  " + str.tostring(p05, format.mintick), cDeep)
    LMV := label.new(bar_index + 12, close, "MVRV " + str.tostring(mvrv, "#.###"),
         xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_label_left,
         chart.fg_color, size.normal)

// ---------------- alerts ----------------
alertcondition(ta.crossunder(mvrv, m25), "ETH MVRV below 25th pct", "ETH MVRV entered its cheap quartile")
alertcondition(ta.crossunder(mvrv, m10), "ETH MVRV below 10th pct", "ETH MVRV in its cheapest decile")
alertcondition(ta.crossover(mvrv,  m75), "ETH MVRV above 75th pct", "ETH MVRV entered its expensive quartile")

// ---------------- compact readout ----------------
bool showTable = input.bool(true, "Show readout", group = "Display")
var table tbl = table.new(position.bottom_right, 2, 3, border_width = 1)
if showTable and barstate.islast
    color mvCol = chart.fg_color
    if mvrv < m25
        mvCol := cLow
    else if mvrv > m75
        mvCol := cHot
    table.cell(tbl, 0, 0, "MVRV", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 0, str.tostring(mvrv, "#.###"), text_color = mvCol, text_size = size.small, text_halign = text.align_right)
    table.cell(tbl, 0, 1, "realised", text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 1, str.tostring(realised, format.mintick), text_color = chart.fg_color, text_size = size.small, text_halign = text.align_right)
    table.cell(tbl, 0, 2, "source", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tbl, 1, 2, useLive ? "live" : "fixed", text_color = color.gray, text_size = size.tiny, text_halign = text.align_right)
