            r := 43.
        else if b == 5
            r := 40.
        else if b == 6
            r := 62.
        else if b == 7
            r := 73.
        else if b == 8
            r := 68.
        else if b == 9
            r := 55.
        else if b == 10
            r := 35.
        else if b == 11
            r := 74.
